{
  "_meta": {
    "version": "1.1.0",
    "description": "KOS 计算平台规则化配置。各平台互动率/影响力/得分公式权重独立可配，禁止硬编码系数。v1.1.0 新增 attribution_weights 供 kos_attribution.py 消费。",
    "updated_at": "2026-09-06"
  },
  "_attribution_weights": {
    "_comment": "kos_attribution.py 归因模块专用阈值与系数（G1 配置化，禁止硬编码）",
    "demand_threshold": 500,
    "time_weight_coeff": 0.5,
    "time_weight_range": 1.0,
    "interaction_threshold": 5000,
    "reach_threshold": 2000,
    "commercial_threshold": 1000
  },
  "xiaohongshu": {
    "label": "小红书",
    "engagement_weights": {
      "likes": 1.0,
      "comments": 2.0,
      "collects": 1.5,
      "shares": 2.0
    },
    "influence": {
      "components": ["engagement_score", "volume_score", "brand_relevance", "quality_score"],
      "engagement_log_base": 10,
      "engagement_coeff": 15.0,
      "engagement_max": 40.0,
      "volume_log_base": 10,
      "volume_coeff": 12.0,
      "volume_max": 20.0,
      "brand_relevance_coeff": 0.2,
      "quality_coeff": 10.0,
      "quality_max": 10.0,
      "risk_penalty_coeff": 0.5
    },
    "score": {
      "formula": "engagement_score + volume_score + brand_relevance * brand_relevance_coeff + quality_score - risk_penalty * risk_penalty_coeff",
      "min": 0,
      "max": 100,
      "round_digits": 2
    },
    "ad_candidate": {
      "natural_log_base": 10,
      "natural_coeff": 12.0,
      "natural_max": 40.0,
      "interaction_quality_coeff": 30.0,
      "interaction_quality_max": 30.0,
      "quality_coeff": 20.0,
      "quality_max": 20.0,
      "risk_penalty_per_unit": 10.0
    },
    "brand_relevance_base": {
      "kos": 30,
      "official": 20,
      "media": 15,
      "institution": 10,
      "normal_user": 5,
      "default": 3
    },
    "brand_relevance_note_bonus": 2.0,
    "brand_relevance_note_bonus_max": 20.0
  },
