# ============================================================
# 序境 / LUMENIS - 环境变量配置模板
# 复制此文件为 .env 并填写实际配置；不得提交真实凭证/登录态/生产数据。
# 当前生产启动链默认使用 8201。
#
# 注意：TAIKOO_* / ZBC_* 等历史环境变量名仍被部分现有运行时代码消费，
# 在完成依赖追踪与回归前不要仅为命名整洁批量重命名。
# ============================================================

# 系统基本配置
ZBC_DB_PATH=
TAIKOO_HOST=0.0.0.0
TAIKOO_PORT=8201
TAIKOO_AUTH_USER=admin
TAIKOO_AUTH_PASSWORD=your_password_here

# 可选账户初始化：只有首次部署明确注入两项时才创建 owner；密码至少 16 字符。
# 已有账户不被启动过程覆盖。初始化后移除注入；轮换走现有账户管理流程。
# 内部 beta 不因此新增产品登录墙；未配置时不创建默认账户或安全问答。
LUMENIS_BOOTSTRAP_OWNER_USERNAME=
LUMENIS_BOOTSTRAP_OWNER_PASSWORD=
# 可选密钥登录：未注入则关闭，不提供默认个人密钥。
V4_ACCESS_KEY=

# Canonical SQLite DB path override（留空 = <repo>/data/monitor.db）
# 测试/CI 应通过隔离临时路径覆盖此值，禁止写入受保护生产候选库。
ZBC_DB_PATH=

# SYSTEM AI Gateway configuration. Product inference is owned by the canonical
# LUMENIS SYSTEM AI Gateway/C2 route. New deployments do not set an engineering
# or provider/model default here; until owned inference is bound, AI-dependent
# results fail closed / UNAVAILABLE. Historical AI_PROVIDER/LOCAL_AI_PREFERRED
# selectors are compatibility-only and must not reactivate retired providers.
AI_TIMEOUT_SECONDS=90
# Retired compatibility keys: keep blank. Ollama, LM Studio and llama.cpp are
# not product fallbacks and must not be probed or started by this template.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
LMSTUDIO_BASE_URL=
LMSTUDIO_MODEL=
LLAMA_CPP_BASE_URL=
LLAMA_CPP_MODEL=

# Retired external-provider compatibility keys: keep blank. They are not
# eligible for product inference, fallback, discovery or automatic routing.
DASHSCOPE_API_KEY=
QWEN_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# 全网话题采集配置
WEB_ADAPTERS=google_news,gdelt,custom_rss
WEB_BASE_QUERY=广州太古汇 OR 太古汇
WEB_RSS_URLS=
WEB_QUERIES=

# 采集调度配置
AUTO_INTERVAL_MINUTES=90

# RedNote automatic collection defaults to manual-only. Enabling it requires
# the existing narrow schedule to be explicitly authorized in full.
REDNOTE_AUTO_RUN=false
REDNOTE_AUTO_SCOPE=
REDNOTE_AUTO_SOURCE=
REDNOTE_AUTO_CADENCE_MINUTES=

# 全网发现配置（历史键名保留）
TAIKOO_WEB_DISCOVERY=1
TAIKOO_WEB_DISCOVERY_TIMEOUT=30

# ============================================================
# 凭证管理
# 微博 / B站 Cookie 凭证：JSON 数组，对应 import_cookies.py 导入。
# 复制以下两行到本机 .env 并填入真实值；.env 必须保持 git ignored。
# ============================================================
ZBC_WEIBO_COOKIE_JSON=[{"name":"PC_TOKEN","value":"PLEASE_FILL","domain":".weibo.com","path":"/","httpOnly":false,"secure":false}]
ZBC_BILI_COOKIE_JSON=[{"name":"SESSDATA","value":"PLEASE_FILL","domain":".bilibili.com","path":"/","httpOnly":true,"secure":true}]

# 系统全局 API 鉴权（可选）：留空=当前内部运行策略；设置后 /api/* 需要 Header X-ZBC-API-Key
ZBC_API_KEY=

# 邮件推送配置
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=your_email@qq.com
EMAIL_SMTP_PASSWORD=your_auth_code
EMAIL_TO=recipient@example.com

# 公司域名配置
COMPANY_DOMAIN=

# ============================================================
# 微信通知中心配置（不替代邮件，作为独立通知渠道）
# 支持多个渠道，配置任一即可，可同时配置多个
# ============================================================

# 渠道1：企业微信群机器人
WECOM_WEBHOOK_URL=

# 渠道2：Server酱
SERVERCHAN_SEND_KEY=

# 渠道3：PushPlus
PUSHPLUS_TOKEN=

# 渠道4：自定义微信公众号
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ID=
WECHAT_RECEIVER_OPENIDS=

# 通知设置
NOTIFICATION_DEDUP_TTL=300
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_HIGH_RISK_PUSH=1
NOTIFICATION_CRITICAL_PUSH=1
NOTIFICATION_SYSTEM_ERROR_PUSH=1
NOTIFICATION_COLLECTION_FAILED_PUSH=1
NOTIFICATION_LOGIN_EXPIRED_PUSH=1
NOTIFICATION_DAILY_REPORT_PUSH=1
NOTIFICATION_WEEKLY_REPORT_PUSH=1

# ===== 动态调度影子→门控（默认 shadow=零行为变化）=====
# shadow：只评估+落 schedule_decisions 审计，不阻断固定时钟
# canary：仅 ZBC_SCHED_GATE_PLATFORMS 列出的平台按 decision.allow 门控
# enforce：全部平台按动态决策门控（只收紧不放松）
ZBC_SCHED_GATE_MODE=shadow
ZBC_SCHED_GATE_PLATFORMS=

# ============================================================
# Repository Registry 路径配置
# 所有路径均为可选；留空时 repository_registry.py 基于 __file__ 自动解析。
# 支持绝对路径或相对于 REPO_ROOT 的相对路径。
# ============================================================
ZBC_REPO_ROOT=
ZBC_CORE_DIR=
ZBC_DATA_DIR=
ZBC_RUNTIME_DIR=
ZBC_BACKUP_DIR=
ZBC_EXPORT_DIR=
ZBC_TEMP_DIR=
ZBC_AI_RUNTIME_DIR=
ZBC_COLLECTOR_DIR=
ZBC_LOG_DIR=
ZBC_CONFIG_DIR=

# ============================================================
# Product-owned AI runtime. External providers and local model servers remain
# disabled even if a legacy compatibility key exists elsewhere in the process.
# ============================================================
ALLOW_CLOUD_AI=false

# Retired Zhipu / Ark compatibility keys: keep empty; never use them to restore
# a product AI route. Historical interfaces remain source compatibility only.
ZHIPU_API_KEY=
ZHIPU_MODEL=
ZHIPU_STRONG_MODEL=
ZHIPU_BASE_URL=

# Retired Ark compatibility keys
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=
ARK_MAX_DAILY_TOKEN=190000

# Retired DashScope compatibility key
DASHSCOPE_BASE_URL=

# OpenAI 代理
OPENAI_PROXY=

# SMTP 新版命名（与历史 EMAIL_* 并存）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=1

# 公司信息（历史键名保留）
TAIKOO_COMPANY_DOMAIN=
TAIKOO_COMPANY_NAME=

# 日报推送小时（0-23）
DAILY_REPORT_HOUR=9

# v4 owner 密钥登录 / ZBMP 访问密钥
V4_ACCESS_KEY=

# 小红书 Cookie（优先使用受保护的本地 Cookie 文件/会话机制；不要提交真实值）
XHS_COOKIE=

# 小红书内置浏览器 Runtime CDP 地址（生产环境使用受保护的本机 Runtime；不要提交 Cookie）
XHS_CDP_URL=

# 内置浏览器导航模式
INTERNAL_BROWSER_NAV_MODE=cdp

# Explicit local, read-only workspace access while product accounts are deferred.
# Requires loopback peer/Host/Origin; does not authorize collection or any writes.
LUMENIS_OPEN_WORKSPACE=0
