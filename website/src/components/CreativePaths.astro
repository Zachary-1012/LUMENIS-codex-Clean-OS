---
import { creationCopy } from "../creation-copy";
import type { Locale } from "../i18n";
import PaintedIcon from "./PaintedIcon.astro";
const { locale } = Astro.props as { locale: Locale };
const c = creationCopy[locale];
---
<section class="creation-section section-pad" id="creation" aria-labelledby="creation-title" data-creation-root>
  <div class="wrap">
    <div class="section-heading">
      <h2 id="creation-title">{c.title}</h2>
      <p>{c.intro}</p>
    </div>
    <nav class="creation-choices" aria-label={c.navigation}>
      {c.items.map(item => <a href={`#create-${item.id}`} data-creation-choice={item.id}>
        <PaintedIcon kind={item.id} />
        <span>{item.name}</span><span class="creation-choice-arrow" aria-hidden="true">↗</span>
      </a>)}
    </nav>
    <div class="creation-panels">
      {c.items.map(item => <article id={`create-${item.id}`} class={`creation-panel creation-panel--${item.id}`} data-creation-panel={item.id} aria-labelledby={`create-${item.id}-title`}>
        <div class="creation-panel__copy">
          <h3 id={`create-${item.id}-title`}>{item.title}</h3>
          <p>{item.description}</p>
          <dl><div><dt>{c.from}</dt><dd>{item.input}</dd></div><div><dt>{c.to}</dt><dd>{item.output}</dd></div></dl>
          <a class="text-link" href="#access">{c.action}<span aria-hidden="true"> ↗</span></a>
        </div>
        <figure class="creation-diagram">
          <div class="creation-diagram__objects" aria-hidden="true"><PaintedIcon kind={item.id} /></div>
          <ol>{item.stages.map((stage, i) => <li><span class="creation-diagram__number">{String(i + 1).padStart(2, "0")}</span>{stage}</li>)}</ol>
          <p>{item.detail}</p>
          <figcaption>{c.preview}</figcaption>
        </figure>
      </article>)}
    </div>
    <p class="creation-note">{c.note}</p>
  </div>
</section>
