{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": {
      "*": "ask"
    },
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny"
  },
  "share": "disabled"
}
