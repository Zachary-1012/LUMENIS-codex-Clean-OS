---
import { copy, locales, type Locale } from '../i18n';
import { localPath, publicCopy, productGuideIds, type PublicFamily, type WorkGuide } from '../public-content';
import { publicDestinations, workspaceHref } from '../site-config.mjs';
import PublicNavigation from './PublicNavigation.astro';
import '../styles/site.css';

interface Props { locale: Locale; family: PublicFamily }
const { locale, family } = Astro.props;
const c = publicCopy[locale];
const title = c.titles[family];
const guides: readonly WorkGuide[] = c.guides;
const sections = family === 'products' || family === 'help' ? [] : c.sections[family];
const canonical = Astro.site ? new URL(localPath(locale, family), Astro.site).href : undefined;
const languageLabels = { 'zh-CN': '简中', en: 'EN', ko: '한국어' };
const legalFamilies: PublicFamily[] = ['terms', 'privacy', 'license'];
const channels = [publicDestinations.contact, publicDestinations.trial, publicDestinations.help];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e5e8e5" />
    <title>{title} · {copy[locale].productName}</title>
    <meta name="description" content={c.intros[family]} />
    <meta name="robots" content={Astro.site ? 'index,follow' : 'noindex,nofollow'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && locales.map((language) => <link rel="alternate" hreflang={language} href={new URL(localPath(language, family), Astro.site).href} />)}
    {canonical && <link rel="alternate" hreflang="x-default" href={new URL(localPath('zh-CN', family), Astro.site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · OEVIRA`} />
    <meta property="og:description" content={c.intros[family]} />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body class="public-document">
    {!Astro.site && <p class="preview-status">{copy[locale].status.preview}</p>}
    <a class="skip-link" href="#main">{copy[locale].skipLabel}</a>
    <header class="site-header">
      <div class="site-header__top wrap">
        <a class="wordmark" href={localPath(locale)}><img class="wordmark__mark" src="/favicon.svg" alt="" width="32" height="32" /><span>{copy[locale].productName}</span></a>
        <nav class="language-nav" aria-label={c.language}>
          {locales.map((language) => <a class:list={['language-nav__link', {'is-current': language === locale}]} lang={language} href={localPath(language, family)} aria-current={language === locale ? 'page' : undefined}>{languageLabels[language]}</a>)}
        </nav>
      </div>
      <div class="site-header__bottom wrap"><PublicNavigation locale={locale} active={family} collapsible /></div>
    </header>
    <main id="main" class="public-main wrap">
      <header class="public-title">
        <a class="public-back" href={localPath(locale)}><span aria-hidden="true">←</span> {c.home}</a>
        <h1>{title}</h1>
        <p>{c.intros[family]}</p>
        <small>{c.updated}</small>
      </header>

      {family === 'products' && <>
        <dl class="product-directions">
          {guides.filter((work) => productGuideIds.includes(work.id as typeof productGuideIds[number])).map((work) => <div class:list={['product-direction', `product-direction--${work.id}`]} id={work.id}>
            <dt><h2>{work.name}</h2></dt>
            <dd>
              <p>{work.input}</p>
              <p class="product-direction__result">{work.result}</p>
              <div class="public-actions">
                <a class="action-link action-link--secondary" href={`${localPath(locale, 'help')}#${work.id}`}>{c.guide}<span aria-hidden="true">↗</span></a>
                {workspaceHref(work.screen, work.entry) && <a class="action-link action-link--primary" href={workspaceHref(work.screen, work.entry)}>{c.start}<span aria-hidden="true">→</span></a>}
              </div>
            </dd>
          </div>)}
        </dl>
        <p class="public-state">{publicDestinations.workspace ? c.scope : c.unavailable}</p>
      </>}

      {family === 'help' && <div class="guide-layout" data-guide-search>
        <aside class="guide-index">
          <label for="guide-search">{c.search}</label>
          <input id="guide-search" type="search" placeholder={c.searchHint} autocomplete="off" />
          <nav aria-label={c.contents}>{guides.map((guide) => <a href={`#${guide.id}`}>{guide.name}</a>)}</nav>
          <p class="guide-scope">{c.scope}</p>
        </aside>
        <div>
          <div class="guide-empty" hidden data-guide-empty role="status"><p>{c.noMatch}</p><button type="button" data-guide-clear>{c.all}</button></div>
          {guides.map((guide) => <article class="work-guide" id={guide.id} data-guide-item>
            <h2>{guide.name}</h2>
            <dl><dt>{c.input}</dt><dd>{guide.input}</dd></dl>
            <h3>{c.steps}</h3>
            <ol>{guide.steps.map((step) => <li>{step}</li>)}</ol>
            <h3>{c.result}</h3><p>{guide.result}</p>
            <details><summary>{c.recovery}</summary><p>{guide.recovery}</p></details>
            {workspaceHref(guide.screen, guide.entry) && <a class="action-link action-link--primary" href={workspaceHref(guide.screen, guide.entry)}>{c.start}<span aria-hidden="true">→</span></a>}
          </article>)}
        </div>
      </div>}

      {family !== 'products' && family !== 'help' && <>
        {family === 'outcomes' && <p class="public-state public-video-state"><svg class="public-play" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><rect x="16" y="20" width="32" height="24" rx="3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M21 20v24m22-24v24M16 27h5m-5 10h5m22-10h5m-5 10h5" fill="none" stroke="currentColor" stroke-width="2" /></svg>{c.noVideo}</p>}
        <div class:list={['public-sections', `public-sections--${family}`]}>
          {sections.map(([heading, body], index) => <section aria-labelledby={`section-${index}`}>
            <h2 id={`section-${index}`}>{heading}</h2><p>{body}</p>
            {family === 'solutions' && <a class="public-text-link" href={localPath(locale, 'products')}>{c.labels.products} <span aria-hidden="true">→</span></a>}
          </section>)}
        </div>
        {family === 'outcomes' && <div class="public-actions"><a class="action-link action-link--secondary" href={localPath(locale, 'help')}>{c.guide}<span aria-hidden="true">→</span></a></div>}
        {family === 'contact' && <ul class="channel-list">{channels.map((href, index) => <li><strong>{c.services[index]}</strong>{href ? <a href={href}>{c.services[index]} →</a> : <span>{copy[locale].access.unconfigured}</span>}</li>)}</ul>}
        {family === 'download' && <div class="public-actions">{publicDestinations.workspace ? <a class="action-link action-link--primary" href={publicDestinations.workspace}>{c.open}<span aria-hidden="true">→</span></a> : <p class="public-state">{c.unavailable}</p>}<a class="public-text-link" href={localPath(locale, 'help')}>{c.guide} →</a></div>}
        {family === 'license' && <p><a class="public-text-link" href="https://github.com/Zachary-1012/LUMENIS-codex-Clean-OS/blob/main/LICENSE">LICENSE · GitHub ↗</a></p>}
        {legalFamilies.includes(family) && <p class="public-state">{c.legalNote}</p>}
      </>}
    </main>
    <footer class="site-footer"><div class="wrap public-footer">
      <a class="wordmark" href={localPath(locale)}>{copy[locale].productName}</a>
      <PublicNavigation locale={locale} active={family} />
      <nav class="footer-nav" aria-label={c.legalNote}>{legalFamilies.map((name) => <a href={localPath(locale, name)}>{c.labels[name]}</a>)}</nav>
    </div></footer>
    <script>
      const root = document.querySelector('[data-guide-search]');
      if (root) {
        const input = root.querySelector('input');
        const items = [...root.querySelectorAll('[data-guide-item]')];
        const empty = root.querySelector('[data-guide-empty]');
        const filter = () => {
          const query = input.value.trim().toLocaleLowerCase(document.documentElement.lang);
          let visible = 0;
          for (const item of items) {
            const matches = !query || item.textContent.toLocaleLowerCase(document.documentElement.lang).includes(query);
            item.hidden = !matches;
            if (matches) visible++;
          }
          empty.hidden = visible > 0;
        };
        input.addEventListener('input', filter);
        root.querySelector('[data-guide-clear]').addEventListener('click', () => { input.value = ''; filter(); input.focus(); });
        // A category jump always restores its guide, including after a search.
        root.querySelectorAll('.guide-index a').forEach((link) => link.addEventListener('click', () => { input.value = ''; filter(); }));
      }
    </script>
  </body>
</html>
