# ============================================================
# 广州太古汇舆情监测系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际配置
# ============================================================

# 系统基本配置
TAIKOO_HOST=0.0.0.0
TAIKOO_PORT=8200
TAIKOO_AUTH_USER=admin
TAIKOO_AUTH_PASSWORD=your_password_here

# AI配置（auto=自动选择，配置Key后自动使用云端AI，否则使用本地Ollama）
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=90
LOCAL_AI_PREFERRED=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
LLAMA_CPP_MODEL=

# 云端AI配置（配置任一即可，auto模式会自动选择）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 全网话题采集配置
WEB_ADAPTERS=google_news,gdelt,custom_rss
WEB_BASE_QUERY=广州太古汇 OR 太古汇
WEB_RSS_URLS=
WEB_QUERIES=

# 采集调度配置
AUTO_INTERVAL_MINUTES=90

# 全网发现配置
TAIKOO_WEB_DISCOVERY=1
TAIKOO_WEB_DISCOVERY_TIMEOUT=30

# ============================================================
# Zachary-OS-AI T0-2 SEC-001 凭证管理
# 微博 / B站 Cookie 凭证：JSON 数组，对应 import_cookies.py 导入。
# 复制以下两行到 .env 并填入真实值；.env 已被 .gitignore 保护，不会入库。
# ============================================================
ZBC_WEIBO_COOKIE_JSON=[{"name":"PC_TOKEN","value":"PLEASE_FILL","domain":".weibo.com","path":"/","httpOnly":false,"secure":false}]
ZBC_BILI_COOKIE_JSON=[{"name":"SESSDATA","value":"PLEASE_FILL","domain":".bilibili.com","path":"/","httpOnly":true,"secure":true}]

# 系统全局 API 鉴权（可选）：留空=局域网内无Header保护；设置后所有 /api/* 需要 Header X-ZBC-API-Key
ZBC_API_KEY=

# 邮件推送配置（系统完善后接入，当前可选）
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=your_email@qq.com
EMAIL_SMTP_PASSWORD=your_auth_code
EMAIL_TO=recipient@example.com

# 公司域名配置（系统完善后接入）
COMPANY_DOMAIN=

# ============================================================
# 微信通知中心配置（不替代邮件，作为独立通知渠道）
# 支持3种推送渠道，配置任一即可，可同时配置多个
# ============================================================

# 渠道1：企业微信群机器人（最稳定，推荐）
# 获取方式：企业微信群 → 右上角 → 群机器人 → 添加机器人 → 复制Webhook地址
WECOM_WEBHOOK_URL=

# 渠道2：Server酱（方糖，个人微信推送）
# 获取方式：https://sct.ftqq.com/ 登录后获取SendKey
SERVERCHAN_SEND_KEY=

# 渠道3：PushPlus（个人微信推送）
# 获取方式：http://www.pushplus.plus/ 登录后获取Token
PUSHPLUS_TOKEN=

# 渠道4：自定义微信公众号（模板消息推送，最稳定，推荐有公众号的用户）
# 获取方式：
#   1. 登录微信公众平台 https://mp.weixin.qq.com/
#   2. 开发 → 基本配置 → 获取AppID和AppSecret
#   3. 功能 → 模板消息 → 添加模板（需要先开通模板消息功能）
#   4. 模板字段约定：first / keyword1(通知类型) / keyword2(内容摘要) / keyword3(时间) / remark
#   5. 获取接收者openid：用户关注公众号后，在用户管理中查看
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ID=
# 多个接收者用逗号分隔，例如：oXXXX1,oXXXX2,oXXXX3
WECHAT_RECEIVER_OPENIDS=

# 通知设置
NOTIFICATION_DEDUP_TTL=300
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_HIGH_RISK_PUSH=1
NOTIFICATION_CRITICAL_PUSH=1
NOTIFICATION_SYSTEM_ERROR_PUSH=1
NOTIFICATION_COLLECTION_FAILED_PUSH=1
NOTIFICATION_LOGIN_EXPIRED_PUSH=1
NOTIFICATION_DAILY_REPORT_PUSH=1
NOTIFICATION_WEEKLY_REPORT_PUSH=1


# ===== GAP-05 动态调度影子→门控（默认 shadow=零行为变化；切 canary/enforce 才门控，回滚改回 shadow 即可）=====
# shadow：只评估+落 schedule_decisions 审计，不阻断固定时钟（默认，最保守）
# canary：仅 ZBC_SCHED_GATE_PLATFORMS 列出的平台按 decision.allow 门控，其余同 shadow
# enforce：全部平台按动态决策门控（只收紧不放松，不弱化既有熔断/冷却）
ZBC_SCHED_GATE_MODE=shadow
# canary 灰度平台名单（逗号分隔，例如 web,bilibili；xhs 最后切）
ZBC_SCHED_GATE_PLATFORMS=
