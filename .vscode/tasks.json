{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LUMENIS: development snapshot",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/local_development.ps1",
        "-Action",
        "snapshot",
        "-Owner",
        "${input:owner}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "LUMENIS: check current file",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/local_development.ps1",
        "-Action",
        "check",
        "-Owner",
        "${input:owner}",
        "-Paths",
        "${relativeFile}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "LUMENIS: preview current file format",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/local_development.ps1",
        "-Action",
        "format-preview",
        "-Owner",
        "${input:owner}",
        "-Paths",
        "${relativeFile}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "LUMENIS: apply explicitly approved format",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/local_development.ps1",
        "-Action",
        "format-apply",
        "-Owner",
        "${input:owner}",
        "-Paths",
        "${relativeFile}",
        "-Manifest",
        "${input:manifest}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "LUMENIS: build website",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/local_development.ps1",
        "-Action",
        "build",
        "-Owner",
        "${input:owner}",
        "-Target",
        "website"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "LUMENIS: build Flutter Web",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/local_development.ps1",
        "-Action",
        "build",
        "-Owner",
        "${input:owner}",
        "-Target",
        "flutter-web"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "command": "pwsh",
      "type": "process",
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "label": "LUMENIS: review current file diff",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/local_development.ps1",
        "-Action",
        "diff",
        "-Owner",
        "${input:owner}",
        "-Paths",
        "${relativeFile}"
      ]
    },
    {
      "command": "pwsh",
      "type": "process",
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "label": "LUMENIS: preview existing locale generation",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/local_development.ps1",
        "-Action",
        "locale-preview",
        "-Owner",
        "${input:owner}"
      ]
    },
    {
      "command": "pwsh",
      "type": "process",
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "label": "LUMENIS: rollback exact tooling receipt",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/local_development.ps1",
        "-Action",
        "rollback",
        "-Owner",
        "${input:owner}",
        "-Paths",
        "${relativeFile}",
        "-Receipt",
        "${input:receipt}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "owner",
      "type": "pickString",
      "description": "Current admitted Owner; this selection grants no write permission",
      "options": [
        "M",
        "F",
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6"
      ],
      "default": "M"
    },
    {
      "id": "manifest",
      "type": "promptString",
      "description": "Existing exact HEAD/hash/reservation-bound explicit format authorization file"
    },
    {
      "description": "Exact prior tooling receipt; current HEAD/hash/reservation must still match",
      "type": "promptString",
      "id": "receipt"
    }
  ]
}
