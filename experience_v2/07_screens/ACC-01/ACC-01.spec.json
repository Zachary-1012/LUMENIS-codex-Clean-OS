{
  "screen": "ACC-01",
  "meta": {
    "domain": "ACCOUNT",
    "group": "acc",
    "icon": "user",
    "zh": "领域登录入口",
    "en": "Domain-first Sign-in",
    "ko": "도메인 로그인",
