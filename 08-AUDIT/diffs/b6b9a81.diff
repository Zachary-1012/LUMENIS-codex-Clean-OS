+# =========================================================
+# PLAYWRIGHT
+# =========================================================
+
+async def browser_audit():
+
+    try:
+
+        from playwright.async_api import async_playwright
+
+    except Exception as e:
+
+        results["browser"] = {
+            "status": "NOT_AVAILABLE",
+            "error": str(e),
+        }
+
+        return False
+
+    browser_result = {
+        "pages": [],
+        "console_errors": [],
+        "network_failures": [],
+        "ui_overflow": [],
+        "hidden_content": [],
+    }
+
+    async with async_playwright() as pw:
+
+        browser = await pw.chromium.launch(
+            headless=True
+        )
+
+        context = await browser.new_context(
+            viewport={
+                "width": 1440,
+                "height": 900,
+            }
+        )
+
+        page = await context.new_page()
+
+        console_errors = []
+
+        def console_handler(msg):
+
+            if msg.type == "error":
+
+                console_errors.append(
+                    msg.text
+                )
+
+        page.on(
+            "console",
+            console_handler,
+        )
+
+        failed_requests = []
+
+        def request_failed(req):
+
+            failed_requests.append({
+                "url": req.url,
+                "method": req.method,
+                "failure": str(req.failure),
+            })
+
+        page.on(
+            "requestfailed",
+            request_failed,
+        )
+
+        # 首页先打开
+        try:
+
+            response = await page.goto(
+                BASE_URL,
+                wait_until="networkidle",
+                timeout=30000,
+            )
+
+            if response:
+
+                browser_result["pages"].append({
+                    "path": "/",
+                    "status": response.status,
+                    "title": await page.title(),
+                })
+
+        except Exception as e:
+
+            browser_result["pages"].append({
+                "path": "/",
+                "error": str(e),
+            })
+
+        # 自动发现站内页面
+        paths = {"/"}
+
+        try:
+
+            links = await page.locator(
+                "a[href]"
+            ).evaluate_all(
+                """
+                els => els.map(
+                    x => x.getAttribute('href')
+                )
+                """
+            )
+
+            for href in links:
+
+                if not href:
+                    continue
+
+                if href.startswith("/"):
+
+                    clean = href.split(
+                        "#"
+                    )[0].split(
+                        "?"
+                    )[0]
+
+                    if clean:
+                        paths.add(clean)
+
+        except Exception:
+            pass
+
+        # 限制为真实内部路径
+        paths = sorted(
+            x for x in paths
+            if x.startswith("/")
+        )
+
+        for path in paths:
+
+            if path == "/":
+                continue
+
+            try:
+
+                response = await page.goto(
+                    BASE_URL.rstrip("/") + path,
+                    wait_until="networkidle",
+                    timeout=20000,
+                )
+
+                status = (
+                    response.status
+                    if response
+                    else None
+                )
+
+                browser_result["pages"].append({
+                    "path": path,
+                    "status": status,
+                    "title": await page.title(),
+                })
+
+            except Exception as e:
+
+                browser_result["pages"].append({
+                    "path": path,
+                    "error": str(e),
+                })
+
+        # -----------------------------------------
+        # 重新检查每个实际页面
+        # -----------------------------------------
+
+        for item in browser_result["pages"]:
+
+            path = item["path"]
+
+            try:
+
+                await page.goto(
+                    BASE_URL.rstrip("/") + path,
+                    wait_until="networkidle",
+                    timeout=20000,
+                )
+
+                inspection = await page.evaluate(
+                    """
+                    () => {
+
+                        const visible = el => {
+
+                            if (!el)
+                                return false;
+
+                            const s =
+                                getComputedStyle(el);
+
+                            const r =
+                                el.getBoundingClientRect();
+
+                            return (
+                                s.display !== 'none' &&
+                                s.visibility !== 'hidden' &&
+                                parseFloat(
+                                    s.opacity || '1'
+                                ) > 0 &&
+                                r.width > 0 &&
+                                r.height > 0
+                            );
+                        };
+
+                        const main =
+                            document.querySelector(
+                                'main'
+                            ) ||
+                            document.querySelector(
+                                '#app'
+                            ) ||
+                            document.querySelector(
+                                '#root'
+                            );
+
+                        const all =
+                            [...document.querySelectorAll('*')];
+
+                        const overflow =
+                            all.filter(el => {
+
+                                const r =
+                                    el.getBoundingClientRect();
+
+                                return (
+                                    r.right >
+                                    window.innerWidth + 2
+                                );
+                            }).slice(0, 30)
+                            .map(el => ({
+                                tag: el.tagName,
+                                id: el.id,
+                                class:
+                                    String(
+                                        el.className || ''
+                                    ).slice(0, 200)
+                            }));
+
+                        const buttons =
+                            [...document.querySelectorAll(
+                                'button,[role="button"],a'
+                            )];
+
+                        const inputs =
+                            [...document.querySelectorAll(
+                                'input,textarea,select'
+                            )];
+
+                        const inlineImportant =
+                            all.filter(el => {
+
+                                for (
+                                    const prop of el.style
+                                ) {
+
+                                    if (
+                                        el.style
+                                            .getPropertyPriority(
+                                                prop
+                                            ) === 'important'
+                                    ) {
+                                        return true;
+                                    }
+                                }
+
+                                return false;
+                            }).length;
+
+                        const inlineEvents =
+                            all.filter(el =>
+                                [...el.attributes]
+                                .some(a =>
+                                    /^on/i.test(
+                                        a.name
+                                    )
+                                )
+                            ).length;
+
+                        return {
+
+                            title:
+                                document.title,
+
+                            bodyText:
+                                document.body
+                                    ?.innerText
+                                    ?.length || 0,
+
+                            mainVisible:
+                                visible(main),
+
+                            buttons:
+                                buttons.length,
+
+                            visibleButtons:
+                                buttons.filter(
+                                    visible
+                                ).length,
+
+                            inputs:
+                                inputs.length,
+
+                            visibleInputs:
+                                inputs.filter(
+                                    visible
+                                ).length,
+
+                            overflow,
+
+                            inlineImportant,
+
+                            inlineEvents,
+
+                            viewport: {
+                                width:
+                                    window.innerWidth,
+                                height:
+                                    window.innerHeight
+                            }
+                        };
+                    }
+                    """
+                )
+
+                item["ui"] = inspection
+
+                if inspection["overflow"]:
+
+                    browser_result[
+                        "ui_overflow"
+                    ].append({
+                        "path": path,
+                        "elements":
+                            inspection["overflow"],
+                    })
+
+                if not inspection["mainVisible"]:
+
+                    browser_result[
+                        "hidden_content"
+                    ].append(path)
+
+            except Exception as e:
+
+                item["runtime_error"] = str(e)
+
+        browser_result[
+            "console_errors"
+        ] = console_errors
+
+        browser_result[
+            "network_failures"
+        ] = failed_requests
+
+        await browser.close()
+
+    results["browser"] = browser_result
+
+    results["ui"]["runtime_overflow"] = (
+        browser_result["ui_overflow"]
+    )
+
+    results["ux"]["hidden_content"] = (
+        browser_result["hidden_content"]
+    )
+
+    results["security"]["browser_console"] = (
+        browser_result["console_errors"]
+    )
+
+    return (
+        not browser_result["console_errors"]
+        and not browser_result["network_failures"]
+        and not browser_result["hidden_content"]
+    )
+
+
