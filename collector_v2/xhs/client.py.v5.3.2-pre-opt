"""
XHSClient - 小红书 HTTP 请求客户端（独立于业务逻辑）

设计原则：
- 请求层与业务逻辑分离
- 只吸收"请求层独立"思想，不抄平台签名/认证实现
- 统一处理请求头、Cookie、重试、限流
- 实际签名逻辑由外部注入或使用浏览器会话
"""
import time
import random
from typing import Optional, Dict, Any, List
from dataclasses import dataclass


@dataclass
class RequestConfig:
    """请求配置"""
    base_url: str = 'https://www.xiaohongshu.com'
    api_base_url: str = 'https://edith.xiaohongshu.com'
    timeout: int = 30
    max_retries: int = 3
    retry_delay: float = 1.0
    rate_limit_per_minute: int = 30
    user_agent: str = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'


class XHSClient:
    """
    小红书 HTTP 客户端

    职责：
    - 管理请求头、Cookie
    - 统一重试、限流逻辑
    - 发送 HTTP 请求，返回原始响应

    不负责：
    - 平台签名（由外部注入或浏览器会话处理）
    - 业务逻辑解析（由 Parser 处理）
    - 主体过滤（由现有系统处理）
    """

    def __init__(self, config: RequestConfig = None, cookies: Dict[str, str] = None):
        self.config = config or RequestConfig()
        self.cookies = cookies or {}
        self._request_count = 0
        self._last_request_time = 0
        self._session = None  # requests.Session 或 aiohttp.ClientSession

    def _rate_limit(self):
        """简单限流：每分钟不超过 rate_limit_per_minute 次"""
        now = time.time()
        if self._last_request_time > 0:
            interval = 60.0 / self.config.rate_limit_per_minute
            elapsed = now - self._last_request_time
            if elapsed < interval:
                time.sleep(interval - elapsed + random.uniform(0, 0.5))
        self._last_request_time = time.time()
        self._request_count += 1

    def _build_headers(self, extra_headers: Dict[str, str] = None) -> Dict[str, str]:
        """构建请求头"""
        headers = {
            'User-Agent': self.config.user_agent,
            'Accept': 'application/json, text/plain, */*',
            'Accept-Language': 'zh-CN,zh;q=0.9,en;q=0.8',
            'Referer': self.config.base_url + '/',
            'Origin': self.config.base_url,
        }
        if extra_headers:
            headers.update(extra_headers)
        return headers

    def get(self, url: str, params: Dict[str, Any] = None,
            headers: Dict[str, str] = None) -> Optional[Dict[str, Any]]:
        """
        发送 GET 请求
        :return: 解析后的 JSON 数据，失败返回 None
        """
        self._rate_limit()
        # 实际实现使用 requests 或 httpx
        # 这里是架构骨架
        for attempt in range(self.config.max_retries):
            try:
                # response = self._session.get(url, params=params, headers=..., cookies=..., timeout=...)
                # return response.json()
                pass
            except Exception as e:
                if attempt < self.config.max_retries - 1:
                    time.sleep(self.config.retry_delay * (attempt + 1))
                else:
                    print(f'[XHSClient] GET 请求失败: {url}, 错误: {e}')
        return None

    def post(self, url: str, data: Dict[str, Any] = None,
             json_data: Dict[str, Any] = None,
             headers: Dict[str, str] = None) -> Optional[Dict[str, Any]]:
        """发送 POST 请求"""
        self._rate_limit()
        # 实际实现
        return None

    def search_notes(self, keyword: str, page: int = 1,
                      page_size: int = 20, sort: str = 'general') -> Optional[Dict[str, Any]]:
        """
        搜索笔记（API 层）
        :param keyword: 关键词
        :param page: 页码
        :param page_size: 每页数量
        :param sort: 排序方式 general / time / popularity
        :return: 原始 API 响应
        """
        url = f'{self.config.api_base_url}/api/sns/web/v1/search/notes'
        params = {
            'keyword': keyword,
            'page': page,
            'page_size': page_size,
            'sort': sort,
            'search_id': self._generate_search_id(),
        }
        return self.get(url, params=params)

    def get_note_detail(self, note_id: str, xsec_token: str = '') -> Optional[Dict[str, Any]]:
        """获取笔记详情（API 层）"""
        url = f'{self.config.api_base_url}/api/sns/web/v1/feed'
        params = {
            'source_note_id': note_id,
            'xsec_token': xsec_token,
        }
        return self.get(url, params=params)

    def get_comments(self, note_id: str, cursor: str = '',
                      page_size: int = 20) -> Optional[Dict[str, Any]]:
        """获取评论（API 层，分页）"""
        url = f'{self.config.api_base_url}/api/sns/web/v2/comment/page'
        params = {
            'note_id': note_id,
            'cursor': cursor,
            'top_comment_id': '',
            'image_formats': 'jpg,webp,avif',
        }
        return self.get(url, params=params)

    def _generate_search_id(self) -> str:
        """生成搜索 ID"""
        return f'{int(time.time() * 1000)}{random.randint(1000, 9999)}'

    def update_cookies(self, cookies: Dict[str, str]):
        """更新 Cookies"""
        self.cookies.update(cookies)

    def close(self):
        """关闭客户端"""
        if self._session:
            try:
                self._session.close()
            except Exception:
                pass
            self._session = None
