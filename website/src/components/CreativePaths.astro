---
import { creationCopy } from "../creation-copy";
import type { Locale } from "../i18n";
import PaintedIcon from "./PaintedIcon.astro";
import { publicCopy, localPath } from "../public-content";
import { workspaceHref } from "../site-config.mjs";

const { locale } = Astro.props as { locale: Locale };
const c = creationCopy[locale];
---

<section class="creation-section section-pad" id="creation" aria-labelledby="creation-title">
  <div class="wrap">
    <div class="section-heading">
      <h2 id="creation-title">{c.title}</h2>
      <p>{c.intro}</p>
    </div>
    <div class="creation-grid">
      {c.items.map((item, index) => <article class="creation-card" aria-labelledby={`creation-${item.id}-title`}>
        <div class="creation-card__top">
          <PaintedIcon kind={item.id} />
          <span class="creation-card__index">0{index + 1}</span>
        </div>
        <p class="creation-card__name">{item.name}</p>
        <h3 id={`creation-${item.id}-title`}>{item.title}</h3>
        <p class="creation-card__description">{item.description}</p>
        <dl class="creation-card__ledger">
          <div><dt>{c.start}</dt><dd>{item.input}</dd></div>
          <div><dt>{c.result}</dt><dd>{item.output}</dd></div>
        </dl>
        <ol class="creation-card__steps">
          {item.stages.map((stage, stageIndex) => <li><span>0{stageIndex + 1}</span>{stage}</li>)}
        </ol>
        <p class="creation-card__detail">{item.detail}</p>
        <div class="public-actions">
          <a class="public-text-link" href={`${localPath(locale, 'help')}#${item.id === 'document' ? 'writing' : item.id === 'audio' ? 'podcast' : 'video'}`}>{publicCopy[locale].guide} <span aria-hidden="true">↗</span></a>
          {workspaceHref('SH-01', item.id === 'document' ? 'manuscript' : item.id) && <a class="action-link action-link--primary" href={workspaceHref('SH-01', item.id === 'document' ? 'manuscript' : item.id)}>{publicCopy[locale].start}<span aria-hidden="true">→</span></a>}
        </div>
      </article>)}
    </div>
    <p class="creation-note">{c.note}</p>
  </div>
</section>
