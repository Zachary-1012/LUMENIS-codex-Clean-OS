# ============================================================
# 序境 / LUMENIS - 环境变量配置模板
# 复制此文件为 .env 并填写实际配置；不得提交真实凭证/登录态/生产数据。
# 当前生产启动链默认使用 8201。
#
# 注意：TAIKOO_* / ZBC_* 等历史环境变量名仍被部分现有运行时代码消费，
# 在完成依赖追踪与回归前不要仅为命名整洁批量重命名。
# ============================================================

# 系统基本配置。TAIKOO_* 为仍被兼容入口读取的历史键名；留空认证项不会创建产品登录墙。
ZBC_DB_PATH=
TAIKOO_HOST=0.0.0.0
TAIKOO_PORT=8201
TAIKOO_AUTH_USER=
TAIKOO_AUTH_PASSWORD=

# 可选账户初始化：只有首次部署明确注入两项时才创建 owner；密码至少 16 字符。
# 已有账户不被启动过程覆盖。初始化后移除注入；轮换走现有账户管理流程。
# 内部 beta 不因此新增产品登录墙；未配置时不创建默认账户或安全问答。
LUMENIS_BOOTSTRAP_OWNER_USERNAME=
LUMENIS_BOOTSTRAP_OWNER_PASSWORD=
# 可选密钥登录：未注入则关闭，不提供默认个人密钥。
V4_ACCESS_KEY=

# Canonical SQLite DB path override（留空 = <repo>/data/monitor.db）
# 测试/CI 应通过隔离临时路径覆盖此值，禁止写入受保护生产候选库。

# SYSTEM AI Gateway configuration. Product inference is owned by the canonical
# LUMENIS SYSTEM AI Gateway/C2 route. New deployments do not set an engineering
# or provider/model default here; until owned inference is bound, AI-dependent
# results fail closed / UNAVAILABLE. Historical AI_PROVIDER/LOCAL_AI_PREFERRED
# selectors must not route to any third-party provider.
AI_TIMEOUT_SECONDS=90

# 全网话题采集兼容配置。默认不启用来源或查询；实际任务从当前 Subject/BrandFocus、Scope、Permission 与 Collector plan 产生。
WEB_ADAPTERS=
WEB_BASE_QUERY=
WEB_RSS_URLS=
WEB_QUERIES=

# 采集调度配置
AUTO_INTERVAL_MINUTES=90
# 风控闸门（限速/熔断/冷却）：研发期 off，闭环前改 on
COLLECTION_RISK_GATING=off

# 可选：用户自购模型 API（OpenAI 兼容）。默认用自有模型；仅当 AI_PROVIDER=user_api 时启用，无自动兜底
USER_MODEL_API_BASE_URL=
USER_MODEL_API_KEY=
USER_MODEL_API_MODEL=

# RedNote automatic collection default: all registered subjects (R&D). Manual remains optional.
REDNOTE_AUTO_RUN=true
REDNOTE_AUTO_SCOPE=ALL_REGISTERED_SUBJECTS
REDNOTE_AUTO_SOURCE=rednote_hk
REDNOTE_AUTO_CADENCE_MINUTES=720

# 抖音与 X 只读 Worker。默认关闭且不提供端点/账号；仅在现有 Permission、专用只读账号与固定 Runtime 合同成立时配置。
DOUYIN_CDP_URL=
DOUYIN_LOCAL_WORKER_ENABLED=false
DOUYIN_LOCAL_WORKER_ACCOUNT=
X_READONLY_CDP_URL=
X_READONLY_LOCAL_WORKER_ENABLED=false
X_READONLY_LOCAL_WORKER_ACCOUNT=

# 全网发现兼容开关（历史键名保留）。默认关闭；不得以广州太古汇或任一测试 Subject 作为产品默认查询。
TAIKOO_WEB_DISCOVERY=0
TAIKOO_WEB_DISCOVERY_TIMEOUT=30

# ============================================================
# 凭证管理
# 微博 / B站 Cookie 凭证：JSON 数组，对应 import_cookies.py 导入。
# 变量默认留空，避免 clean clone 把示例字符串误判为已配置凭据；.env 必须保持 git ignored。
# 格式示例仅供人工填写：[{"name":"COOKIE_NAME","value":"REAL_VALUE","domain":".example.com","path":"/"}]
# ============================================================
ZBC_WEIBO_COOKIE_JSON=
ZBC_BILI_COOKIE_JSON=

# 系统全局 API 鉴权（可选）：留空=当前内部运行策略；设置后 /api/* 需要 Header X-ZBC-API-Key
ZBC_API_KEY=

# 历史邮件兼容配置。邮件不是当前产品交付入口，默认全部关闭；不得因模板值自动启用。
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_TO=

# 公司域名配置
COMPANY_DOMAIN=

# ============================================================
# 微信通知中心配置（不替代邮件，作为独立通知渠道）
# 支持多个渠道，配置任一即可，可同时配置多个
# ============================================================

# 渠道1：企业微信群机器人
WECOM_WEBHOOK_URL=

# 渠道2：Server酱
SERVERCHAN_SEND_KEY=

# 渠道3：PushPlus
PUSHPLUS_TOKEN=

# 渠道4：自定义微信公众号
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ID=
WECHAT_RECEIVER_OPENIDS=

# 通知设置
NOTIFICATION_DEDUP_TTL=300
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_HIGH_RISK_PUSH=1
NOTIFICATION_CRITICAL_PUSH=1
NOTIFICATION_SYSTEM_ERROR_PUSH=1
NOTIFICATION_COLLECTION_FAILED_PUSH=1
NOTIFICATION_LOGIN_EXPIRED_PUSH=1
NOTIFICATION_DAILY_REPORT_PUSH=1
NOTIFICATION_WEEKLY_REPORT_PUSH=1

# ===== 动态调度影子→门控（默认 shadow=零行为变化）=====
# shadow：只评估+落 schedule_decisions 审计，不阻断固定时钟
# canary：仅 ZBC_SCHED_GATE_PLATFORMS 列出的平台按 decision.allow 门控
# enforce：全部平台按动态决策门控（只收紧不放松）
ZBC_SCHED_GATE_MODE=shadow
ZBC_SCHED_GATE_PLATFORMS=

# ============================================================
# Repository Registry 路径配置
# 所有路径均为可选；留空时 repository_registry.py 基于 __file__ 自动解析。
# 支持绝对路径或相对于 REPO_ROOT 的相对路径。
# ============================================================
ZBC_REPO_ROOT=
ZBC_CORE_DIR=
ZBC_DATA_DIR=
ZBC_RUNTIME_DIR=
ZBC_BACKUP_DIR=
ZBC_EXPORT_DIR=
ZBC_TEMP_DIR=
ZBC_AI_RUNTIME_DIR=
ZBC_COLLECTOR_DIR=
ZBC_LOG_DIR=
ZBC_CONFIG_DIR=

# 本机媒体工具路径。留空表示未配置；必须指向当前 C6 验证过的 ffmpeg/ffprobe 文件。
LUMENIS_FFMPEG_PATH=
LUMENIS_FFPROBE_PATH=

# Evidence / Training Receipt 本地签名密钥引用。真实 key ring 属于受保护本机配置，不得提交。
LUMENIS_EVIDENCE_HMAC_KEY_RING=
LUMENIS_EVIDENCE_HMAC_ACTIVE_KEY_ID=
LUMENIS_TRAINING_RECEIPT_KEY_RING=
LUMENIS_TRAINING_RECEIPT_ACTIVE_KEY_ID=

# C2 私有 SSH endpoint 配置文件路径；留空时使用现有本机私有默认解析，不得提交 endpoint 内容。
LUMENIS_TRAINING_SSH_ENDPOINT_PATH=

# 公共来源 DNS-over-HTTPS 兼容回退默认关闭；开启必须由当前 Collector/网络策略明确批准。
LUMENIS_PUBLIC_SOURCE_DOH_FALLBACK=false

# ============================================================
# Product-owned AI runtime. External providers and local model servers remain
# disabled even if a legacy compatibility key exists elsewhere in the process.
# ============================================================
ALLOW_CLOUD_AI=false
# 产品账号体系：闭环后开启；研发/内测默认 off
ACCOUNT_SYSTEM_ENABLED=off


# OpenAI 代理
OPENAI_PROXY=

# SMTP 兼容命名（与历史 EMAIL_* 并存）；Host/User/Password 留空即关闭。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=1

# 公司信息（历史键名保留）
TAIKOO_COMPANY_DOMAIN=
TAIKOO_COMPANY_NAME=

# 日报推送小时（0-23）
DAILY_REPORT_HOUR=9

# V4_ACCESS_KEY 已在凭证管理段定义一次；此处不重复定义。

# 小红书 Cookie（优先使用受保护的本地 Cookie 文件/会话机制；不要提交真实值）
XHS_COOKIE=

# 小红书内置浏览器 Runtime CDP 地址（生产环境使用受保护的本机 Runtime；不要提交 Cookie）
XHS_CDP_URL=

# 内置浏览器导航模式
INTERNAL_BROWSER_NAV_MODE=cdp

# Explicit local, read-only workspace access while product accounts are deferred.
# Requires loopback peer/Host/Origin; does not authorize collection or any writes.
LUMENIS_OPEN_WORKSPACE=0
