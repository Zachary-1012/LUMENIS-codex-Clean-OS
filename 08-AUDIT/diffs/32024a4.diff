+        assert "migration_history" in migrated.state_snapshot
+        history = migrated.state_snapshot["migration_history"]
+        assert len(history) == 1
+        assert history[0]["from_bundle"] == bundle.bundle_id
+        assert history[0]["to_env"] == "remote"
+
