+
+    def test_from_tool_definition_with_enum_objects(self):
+        """模拟带枚举值的 ToolParam 对象。"""
+        class FakeParam:
+            def __init__(self, name, type, required, default, enum):
+                self.name = name
+                self.type = type
+                self.required = required
+                self.default = default
+                self.enum = enum
+
+        class FakeToolDef:
+            tool_id = "fake_tool"
+            name = "模拟工具"
+            description = "模拟 ToolDefinition"
