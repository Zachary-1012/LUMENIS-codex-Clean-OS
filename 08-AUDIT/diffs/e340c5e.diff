+<script>
+// 模组管理器
+window.ModuleManager = {
+  modules: [],
+  currentFilter: 'all',
+
+  init: function() {
+    this.load();
+  },
+
+  load: function() {
+    LUMENIS.fetch('/api/modules').then(function(res) {
+      if (res.ok && res.modules) {
+        ModuleManager.modules = res.modules;
+        ModuleManager.render();
+      }
+    }).catch(function(e) {
+      document.getElementById('module-list').innerHTML = '<div style="padding:20px;text-align:center;color:var(--zbc-danger)">加载失败: ' + e + '</div>';
+    });
+  },
+
+  filter: function(domain) {
+    this.currentFilter = domain;
+    document.querySelectorAll('.module-filter .zbc-btn').forEach(function(b) {
+      b.classList.toggle('is-active', b.dataset.domainFilter === domain);
+    });
+    this.render();
+  },
+
+  render: function() {
+    var list = document.getElementById('module-list');
+    var filtered = this.currentFilter === 'all'
+      ? this.modules
+      : this.modules.filter(function(m) { return m.domain === ModuleManager.currentFilter; });
+
+    var enabled = filtered.filter(function(m) { return m.enabled; }).length;
+    document.getElementById('module-stats').textContent =
+      filtered.length + ' 个模组 · ' + enabled + ' 已启用';
+
+    list.innerHTML = filtered.map(function(m, i) {
+      return '<div class="module-item ' + (m.enabled ? '' : 'is-disabled') + '" ' +
+        'draggable="true" data-module-id="' + m.module_id + '" data-index="' + i + '">' +
+        '<span class="module-drag">⋮⋮</span>' +
+        '<span class="module-icon">' + m.icon + '</span>' +
+        '<div class="module-info">' +
+          '<div class="module-name">' + m.name + '</div>' +
+          '<div class="module-desc">' + (m.description || '') + '</div>' +
+          '<div class="module-meta"><span class="module-domain-tag ' + m.domain + '">' + m.domain.toUpperCase() + '</span></div>' +
+        '</div>' +
+        '<div class="module-order">' +
+          '<button onclick="ModuleManager.moveUp(\'' + m.module_id + '\')" title="上移">▲</button>' +
+          '<button onclick="ModuleManager.moveDown(\'' + m.module_id + '\')" title="下移">▼</button>' +
+        '</div>' +
+        '<label class="module-toggle">' +
+          '<input type="checkbox" ' + (m.enabled ? 'checked' : '') + ' onchange="ModuleManager.toggle(\'' + m.module_id + '\', this.checked)">' +
+          '<span class="slider"></span>' +
+        '</label>' +
+      '</div>';
+    }).join('');
+
+    this._bindDrag();
+  },
+
+  toggle: function(moduleId, enabled) {
+    LUMENIS.fetch('/api/modules/' + moduleId + '/toggle', {
+      method: 'POST',
+      body: JSON.stringify({ enabled: enabled })
+    }).then(function() {
+      ModuleManager.load();
+    }).catch(function(e) { alert('操作失败: ' + e); });
+  },
+
+  moveUp: function(moduleId) {
+    var idx = this.modules.findIndex(function(m) { return m.module_id === moduleId; });
+    if (idx > 0) {
+      var tmp = this.modules[idx];
+      this.modules[idx] = this.modules[idx-1];
+      this.modules[idx-1] = tmp;
+      this._saveOrder();
+    }
+  },
+
+  moveDown: function(moduleId) {
+    var idx = this.modules.findIndex(function(m) { return m.module_id === moduleId; });
+    if (idx < this.modules.length - 1) {
+      var tmp = this.modules[idx];
+      this.modules[idx] = this.modules[idx+1];
+      this.modules[idx+1] = tmp;
+      this._saveOrder();
+    }
+  },
+
+  _saveOrder: function() {
+    var ids = this.modules.map(function(m) { return m.module_id; });
+    LUMENIS.fetch('/api/modules/reorder', {
+      method: 'POST',
+      body: JSON.stringify({ order: ids })
+    }).then(function() { ModuleManager.render(); }).catch(function(){});
+  },
+
+  reset: function() {
+    if (confirm('确定恢复默认模组配置？')) {
+      LUMENIS.fetch('/api/modules/reset', { method: 'POST' }).then(function() {
+        ModuleManager.load();
+      });
+    }
+  },
+
+  _bindDrag: function() {
+    var items = document.querySelectorAll('.module-item');
+    var dragSrc = null;
+    items.forEach(function(item) {
+      item.addEventListener('dragstart', function(e) {
+        dragSrc = this;
+        this.classList.add('dragging');
+      });
+      item.addEventListener('dragend', function() {
+        this.classList.remove('dragging');
+      });
+      item.addEventListener('dragover', function(e) { e.preventDefault(); });
+      item.addEventListener('drop', function(e) {
+        e.preventDefault();
+        if (dragSrc && dragSrc !== this) {
+          var fromId = dragSrc.dataset.moduleId;
+          var toId = this.dataset.moduleId;
+          var fromIdx = ModuleManager.modules.findIndex(function(m){return m.module_id===fromId;});
+          var toIdx = ModuleManager.modules.findIndex(function(m){return m.module_id===toId;});
+          var moved = ModuleManager.modules.splice(fromIdx, 1)[0];
+          ModuleManager.modules.splice(toIdx, 0, moved);
+          ModuleManager._saveOrder();
+        }
+      });
+    });
+  }
+};
+
+// 切换到模组面板时初始化
+var _origSwitchPanel = window.switchPanel;
+window.switchPanel = function(name) {
+  _origSwitchPanel(name);
+  if (name === 'modules') {
+    setTimeout(function() { ModuleManager.init(); }, 100);
+  }
+};
+</script>
+
 </body>
