/* ===== 采集刷新 ===== */
async function refresh(){try{const d=await api('/api/intelligence/refresh',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({limit:5000})});$('progressBar').style.width='15%';toast('更新任务已启动');if(d.task_id)poll(d.task_id)}catch(e){toast(e.message)}}
async function poll(id){for(let i=0;i<120;i++){await new Promise(r=>setTimeout(r,2500));try{const d=await api('/api/collect/status/'+id);$('progressBar').style.width=Math.min(95,20+i*1.2)+'%';if(d.task?.status==='done'){toast('更新完成');$('progressBar').style.width='100%';load();return}if(d.task?.status==='error'){toast('任务失败：'+(d.task.message||''));return}}catch(e){return}}}

/* ===== 采集状态显示（v5.6.3 新调度机制） ===== */
async function loadCollectionStatus(){try{const d=await api('/api/xhs/cookie/status');
  // 更新次数显示
  if($('todayRuns'))$('todayRuns').textContent=(d.today_runs||0)+'/'+(d.max_daily_runs||12);
