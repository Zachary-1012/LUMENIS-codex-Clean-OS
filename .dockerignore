# Keep the image lean and secret-free. Never bake in local state/credentials.
# Python / caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# VCS / IDE
.git/
.gitignore
.trae-cn/
.vscode/
.idea/

# Local bundled runtimes / node
nodejs/
node_modules/

# Runtime state (mounted as volumes instead)
data/
staging/
logs/
backups/
video_frames/

# Local browser CDP profiles (never containerize a real login profile)
edge-cdp-*/
chrome-cdp-*/

# Secrets / local config
.env
*.env
!*.env.example

# Databases (mounted, never baked in)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Tests' one-off artifacts / archived snapshots
tests/_archive/
tests/_*.py
tests/_*.png
tests/_*.bin
tests/_*.txt

# Local backups / scratch
*.bak
*.bak-*
app.py.bak-*

# OS / docs not needed at runtime
*.md
docs/
