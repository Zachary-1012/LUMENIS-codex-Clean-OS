{
  "version": "2026.08.27",
  "app_name": "广州太古汇舆情监测系统",
  "app_version": "v5.7.0",
  "description": "广州太古汇小红书舆情监测系统配置",
  "server": {
    "host": "0.0.0.0",
    "port": 8200,
    "debug": false,
    "threaded": true
  },
  "auth": {
    "enabled": true,
    "username_env": "TAIKOO_AUTH_USER",
    "password_env": "TAIKOO_AUTH_PASSWORD"
  },
  "collection": {
    "platform": "rednote",
    "daily_limit": 12,
    "manual_limit": 3,
    "auto_limit": 9,
    "auto_schedule_hours": [8, 10, 12, 14, 16, 18, 20, 22, 23],
