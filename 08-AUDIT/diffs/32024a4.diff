+    def test_completed_task_not_blocked(self, detector):
+        signals = detector.detect_signals({
+            "task_progress": {"task_id": "t3", "status": "completed",
+                              "stuck_seconds": 9999}
+        })
+        assert not any(s.signal_type == SignalType.TASK_BLOCKED.value
+                       for s in signals)
