        <div class="trend-bar-wrapper" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer" 
             onclick="showTrendDetail('${d.date}', ${d.total}, ${d.negative}, ${d.negative_pct}, ${d.high}, ${d.high_pct})">
          <div class="trend-bar" style="width:100%;max-width:40px;height:${height}%;background:linear-gradient(180deg,#007aff,#5ac8fa);border-radius:4px 4px 0 0;position:relative;min-height:4px">
