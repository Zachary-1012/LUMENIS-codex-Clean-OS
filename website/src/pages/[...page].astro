---
import { locales } from '../i18n';
import { publicFamilies, localPath } from '../public-content';
import PublicContent from '../components/PublicContent.astro';

export function getStaticPaths() {
  return locales.flatMap((locale) => publicFamilies.map((family) => ({
    params: { page: localPath(locale, family).replace(/^\//, '').replace(/\/$/, '') },
    props: { locale, family },
  })));
}
const { locale, family } = Astro.props;
---
<PublicContent locale={locale} family={family} />
