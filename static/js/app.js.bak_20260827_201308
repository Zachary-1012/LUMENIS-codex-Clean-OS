async function loadNegativeList() {
  const container = document.getElementById('negativeList');
  if (!container) return;
  container.innerHTML = '<div style="text-align:center;padding:40px;color:var(--muted)">加载中...</div>';
  
  try {
    const data = await api(`/api/negative/pending?status=${_negativeTab}&page=${_negativePage}&per_page=${_negativePerPage}`);
    const notes = data.notes || [];
    const total = data.total || 0;
    
    if (notes.length === 0) {
      container.innerHTML = `<div style="text-align:center;padding:40px;color:var(--muted)">暂无${_negativeTab === 'pending' ? '待确认' : _negativeTab === 'confirmed' ? '已确认' : '已驳回'}的负面笔记</div>`;
      document.getElementById('negativePagination').innerHTML = '';
      return;
    }
    
    container.innerHTML = notes.map(n => {
      const title = n.title || '无标题';
      const author = n.author_nickname || '匿名';
      const date = n.publish_date || n.created_at || '-';
      const likes = n.likes || 0;
      const comments = n.comments || 0;
      const risk = n.risk_level || 'low';
      const riskColor = risk === 'high' ? 'red' : risk === 'medium' ? 'amber' : 'gray';
      const summary = (n.summary || '').substring(0, 100);
      const url = n.url || '#';
      const confirmed = n.negative_confirmed;
      
      let actionBtns = '';
      if (_negativeTab === 'pending') {
        actionBtns = `
          <button class="action primary" style="padding:6px 14px;font-size:12px" onclick="confirmNegative('${n.note_id}')">✓ 确认负面</button>
          <button class="action tertiary" style="padding:6px 14px;font-size:12px" onclick="rejectNegative('${n.note_id}')">✗ 驳回</button>
        `;
      } else if (_negativeTab === 'confirmed') {
        actionBtns = `<span style="color:#34c759;font-size:12px">✓ 已确认 (${n.negative_confirmed_at || ''})</span>`;
      } else {
        actionBtns = `<span style="color:#999;font-size:12px">✗ 已驳回 (${n.negative_confirmed_at || ''})</span>`;
      }
      
      return `
        <div class="note-card glass-card" style="margin-bottom:12px;padding:16px">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
            <div style="flex:1;min-width:0">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap">
                <span class="risk-badge ${riskColor}" style="font-size:11px;padding:2px 8px;border-radius:10px">${risk === 'high' ? '高风险' : risk === 'medium' ? '中风险' : '低风险'}</span>
                <span style="font-size:12px;color:var(--muted)">${author}</span>
                <span style="font-size:12px;color:var(--muted)">${date}</span>
              </div>
              <h4 style="margin:0 0 6px;font-size:15px;line-height:1.4">${title}</h4>
              ${summary ? `<p style="margin:0 0 8px;font-size:13px;color:var(--muted);line-height:1.5">${summary}...</p>` : ''}
              <div style="display:flex;gap:16px;font-size:12px;color:var(--muted)">
                <span>👍 ${likes}</span>
                <span>💬 ${comments}</span>
                <a href="${url}" target="_blank" style="color:var(--accent);text-decoration:none">查看原文 →</a>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;flex-shrink:0">
              ${actionBtns}
            </div>
          </div>
        </div>
      `;
    }).join('');
    
    // 分页
    const totalPages = Math.ceil(total / _negativePerPage);
    const pagContainer = document.getElementById('negativePagination');
    if (totalPages > 1) {
      let pagHtml = '';
      if (_negativePage > 1) pagHtml += `<button class="action tertiary" style="padding:6px 12px" onclick="changeNegativePage(${_negativePage - 1})">‹ 上一页</button>`;
      pagHtml += `<span style="padding:6px 12px;font-size:13px">${_negativePage} / ${totalPages}</span>`;
      if (_negativePage < totalPages) pagHtml += `<button class="action tertiary" style="padding:6px 12px" onclick="changeNegativePage(${_negativePage + 1})">下一页 ›</button>`;
      pagContainer.innerHTML = pagHtml;
    } else {
      pagContainer.innerHTML = '';
    }
    
  } catch(e) {
    console.error('加载负面列表失败', e);
    container.innerHTML = `<div style="text-align:center;padding:40px;color:red">加载失败: ${e.message}</div>`;
  }
}

