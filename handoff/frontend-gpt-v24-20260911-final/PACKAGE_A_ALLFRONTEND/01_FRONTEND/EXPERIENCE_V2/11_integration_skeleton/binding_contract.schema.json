{
  "$schema": "http://json-schema.org/draft-07#",
  "title": "LUMENIS Screen ViewModel Binding Contract",
  "type": "object",
  "required": [
    "screen",
    "state_source",
    "sections"
  ],
  "properties": {
    "screen": {
      "type": "string"
    },
    "state_source": {
      "enum": [
        "backend",
        "frontend-derived",
        "user-input",
        "DESIGN_ONLY fixture"
      ]
    },
    "subject_context": {
      "type": "object",
      "required": [
        "subject_id",
        "subject_type",
        "domain",
        "scope",
        "permissions",
        "time_window",
        "locale",
        "context_version"
      ]
    },
    "sections": {
      "type": "object"
    },
    "actions": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array"
    }
  }
}
