---
import { copy, locales, type Locale } from "../i18n";
import { publicDestinations } from "../site-config.mjs";
import PaintedIcon from "./PaintedIcon.astro";
import CreativePaths from "./CreativePaths.astro";
import OperationVideo from "./OperationVideo.astro";
import "../styles/site.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
const localePath: Record<Locale, string> = {
  "zh-CN": "/",
  en: "/en/",
  ko: "/ko/",
};
const languageLabels: Record<Locale, string> = {
  "zh-CN": "简中",
  en: "EN",
  ko: "한국어",
};
const openGraphLocale: Record<Locale, string> = {
  "zh-CN": "zh_CN",
  en: "en_US",
  ko: "ko_KR",
};
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const absoluteLocalePath = (path: string) =>
  Astro.site ? new URL(path, Astro.site).href : undefined;
const isIndexableBuild = Boolean(Astro.site);
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: c.productName,
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  inLanguage: c.lang,
};

const accessItems = [
  {
    key: "trial",
    title: c.access.trial.title,
    action: c.access.trial.action,
    href: publicDestinations.trial,
    statusId: c.access.trialStateId,
  },
  {
    key: "contact",
    title: c.access.contact.title,
    action: c.access.contact.action,
    href: publicDestinations.contact,
    statusId: c.access.contactStateId,
  },
  {
    key: "help",
    title: c.access.help.title,
    action: c.access.help.action,
    href: publicDestinations.help,
    statusId: c.access.helpStateId,
  },
  {
    key: "workspace",
    title: c.access.workspace.title,
    action: c.access.workspace.action,
    href: publicDestinations.workspace,
    statusId: c.access.workspaceStateId,
  },
];
const workflows = [
  { id: "commerce", scenario: c.scenarios.commerce },
  { id: "brand", scenario: c.scenarios.brand },
];
---

<!doctype html>
<html lang={c.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f1" />
    <meta name="description" content={c.metadata.description} />
    <meta name="robots" content={isIndexableBuild ? "index,follow" : "noindex,nofollow"} />
    <title>{c.metadata.title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && locales.map((alternate) => (
      <link rel="alternate" hreflang={alternate} href={absoluteLocalePath(localePath[alternate])} />
    ))}
    {canonicalUrl && <link rel="alternate" hreflang="x-default" href={absoluteLocalePath(localePath["zh-CN"])} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.metadata.title} />
    <meta property="og:description" content={c.metadata.description} />
    <meta property="og:locale" content={openGraphLocale[locale]} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    {!isIndexableBuild && <p class="preview-status">{c.status.preview}</p>}
    <a class="skip-link" href="#main">{c.skipLabel}</a>

    <header class="site-header">
      <div class="site-header__top wrap">
        <a class="wordmark" href={localePath[locale]} aria-label={c.productName}>
          <svg class="wordmark__mark" viewBox="0 0 30 30" aria-hidden="true" focusable="false">
            <g stroke-width="1.35">
              <path d="M24.3777697427 20.7495595182 A11 11 0 1 1 24.1818406332 8.9424590314" />
              <path d="M19.0717816262 20.6939085335 A7 7 0 1 1 21.3534329537 12.0616518751" />
            </g>
            <circle cx="15" cy="15" r="1.5" />
          </svg>
          <span>{c.productName}</span>
        </a>
        <nav class="language-nav" aria-label={c.languageNavigationLabel}>
          {locales.map((supported) => (
            <a
              href={localePath[supported]}
              lang={supported}
              aria-current={supported === locale ? "page" : undefined}
              class:list={["language-nav__link", { "is-current": supported === locale }]}
            >
              {languageLabels[supported]}
            </a>
          ))}
        </nav>
      </div>
      <div class="site-header__bottom wrap">
        <nav class="primary-nav" aria-label={c.primaryNavigationLabel}>
          {c.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <span class="header-note">{c.headerNote}</span>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__inner wrap">
          <div class="hero__copy">
            <h1 id="hero-title">{c.hero.title}</h1>
            <p class="hero__description">{c.hero.description}</p>
            <div class="hero__actions">
              {publicDestinations.workspace ? (
                <a class="action-link action-link--primary" data-magnetic href={publicDestinations.workspace} aria-describedby="hero-workspace-status">
                  {c.hero.primary}<span class="action-link__icon" aria-hidden="true"></span>
                </a>
              ) : (
                <span class="action-link action-link--disabled" aria-disabled="true" aria-describedby="hero-workspace-status">
                  {c.hero.primaryUnavailable}<span class="action-link__icon action-link__icon--unavailable" aria-hidden="true"></span>
                </span>
              )}
              <a class="action-link action-link--secondary" data-magnetic href="#scenarios">
                {c.hero.secondary}<span class="action-link__icon action-link__icon--down" aria-hidden="true"></span>
              </a>
            </div>
            <p class="hero__note" id="hero-workspace-status">
              <span aria-hidden="true"></span>
              {publicDestinations.workspace ? c.hero.workspaceConfiguredNote : c.hero.workspaceUnavailableNote}
            </p>
          </div>

          <figure class="hero-field" aria-labelledby="hero-visual-caption">
            <div class="hero-paper" aria-hidden="true">
              <div class="hero-paper__research"><PaintedIcon kind="research" /></div>
              <svg class="hero-paper__path" viewBox="0 0 460 300" fill="none"><path d="M91 81C226 2 388 52 360 177S170 320 101 213"/><path d="m91 220 11-10 10 11"/></svg>
              <div class="hero-paper__document"><PaintedIcon kind="document" /></div>
              <div class="hero-paper__video"><PaintedIcon kind="video" /></div>
              <div class="hero-paper__audio"><PaintedIcon kind="audio" /></div>
              <span class="hero-field__label hero-field__label--source">{c.hero.flowLabels.material}</span>
              <span class="hero-field__label hero-field__label--trace">{c.hero.flowLabels.delivery}</span>
              <span class="hero-field__label hero-field__label--return">{c.hero.flowLabels.feedback}</span>
            </div>
            <figcaption id="hero-visual-caption">{c.hero.diagramLabel}</figcaption>
          </figure>
        </div>
      </section>

      <CreativePaths locale={locale} />
      <OperationVideo locale={locale} />

      <section class="sequence-section" aria-labelledby="sequence-title">
        <div class="section-heading wrap">
          <h2 id="sequence-title">{c.sequence.heading}</h2>
          <p>{c.sequence.intro}</p>
        </div>
        <ol class="sequence-track wrap" aria-label={c.hero.diagramLabel}>
          {c.sequence.nodes.map((node, index) => (
            <li class="sequence-node">
              <span class="sequence-node__index">0{index + 1}</span>
              <span class="sequence-node__name">{node.name}</span>
              <span class="sequence-node__english">{node.english}</span>
              <span class="sequence-node__meaning">{node.meaning}</span>
            </li>
          ))}
        </ol>
        <p class="return-line wrap"><span aria-hidden="true"></span>{c.sequence.returnLabel}</p>
      </section>

      <section class="structure-section section-pad" id="structure" aria-labelledby="structure-title">
        <div class="wrap">
          <div class="section-heading">
            <h2 id="structure-title">{c.structure.title}</h2>
            <p>{c.structure.intro}</p>
          </div>

          <div class="domain-split">
            <article class="domain domain--commerce" aria-labelledby="commerce-title">
              <span class="domain__orb" aria-hidden="true"></span>
              <h3 id="commerce-title">{c.structure.commerce.title}</h3>
              <p>{c.structure.commerce.description}</p>
              <p class="domain__lens">{c.structure.commerce.lens}</p>
            </article>
            <article class="domain domain--brand" aria-labelledby="brand-title">
              <span class="domain__orb" aria-hidden="true"></span>
              <h3 id="brand-title">{c.structure.brand.title}</h3>
              <p>{c.structure.brand.description}</p>
              <p class="domain__lens">{c.structure.brand.lens}</p>
            </article>
          </div>

          <div class="foundation-rows">
            <article class="foundation-row" aria-labelledby="shared-title">
              <h3 id="shared-title">{c.structure.shared.title}</h3>
              <p>{c.structure.shared.description}</p>
            </article>
            <article class="foundation-row" aria-labelledby="system-title">
              <h3 id="system-title">{c.structure.system.title}</h3>
              <p>{c.structure.system.description}</p>
            </article>
          </div>
        </div>
      </section>

      <section class="scenarios-section section-pad" id="scenarios" aria-labelledby="scenarios-title">
        <div class="wrap">
          <div class="section-heading">
            <h2 id="scenarios-title">{c.scenarios.title}</h2>
            <p>{c.scenarios.intro}</p>
          </div>
          <div
            class="workflow-explorer"
            data-workflow-root
            data-workflow-position-pattern={c.workflow.positionPattern}
            data-workflow-question-changed={c.workflow.questionChangedAnnouncement}
            data-workflow-restored={c.workflow.restoredAnnouncement}
            data-workflow-stage-prefix={c.workflow.stageAnnouncementPrefix}
          >
            <div
              class="workflow-question-list"
              data-workflow-question-controls
              role="group"
              aria-label={c.workflow.questionGroupLabel}
              hidden
            >
              {workflows.map((workflow, workflowIndex) => (
                <button
                  class="workflow-question"
                  id={`scenario-select-${workflow.id}`}
                  type="button"
                  data-workflow-question={workflow.id}
                >
                  <span class="workflow-question__index" aria-hidden="true">0{workflowIndex + 1}</span>
                  <span class="workflow-question__copy">
                    <strong>{workflow.scenario.title}</strong>
                    <span>{workflow.scenario.question}</span>
                  </span>
                  <span class="workflow-question__state">{c.workflow.selectedLabel}</span>
                </button>
              ))}
            </div>

            <div class="workflow-panels">
              {workflows.map((workflow, workflowIndex) => (
                <article
                  class="workflow-panel"
                  id={`scenario-${workflow.id}`}
                  data-workflow-panel={workflow.id}
                  aria-labelledby={`scenario-${workflow.id}-title`}
                >
                  <header class="workflow-panel__header">
                    <span class="workflow-panel__index" aria-hidden="true">0{workflowIndex + 1}</span>
                    <div class="workflow-panel__heading">
                      <h3 id={`scenario-${workflow.id}-title`}>{workflow.scenario.title}</h3>
                      <p class="workflow-panel__question">{workflow.scenario.question}</p>
                    </div>
                    <span class="workflow-preview-label">{c.workflow.previewLabel}</span>
                  </header>
                  <p class="workflow-panel__description">{workflow.scenario.description}</p>

                  <div
                    class="workflow-stage-list"
                    data-workflow-stage-controls
                    role="tablist"
                    aria-label={c.workflow.stageGroupLabel}
                    hidden
                  >
                    {workflow.scenario.stages.map((stage, stageIndex) => (
                      <button
                        class="workflow-stage-tab"
                        id={`scenario-tab-${workflow.id}-${stage.id}`}
                        type="button"
                        data-workflow-stage-tab={stage.id}
                      >
                        <span>{stage.label}</span>
                        <span class="workflow-stage-tab__state">{c.workflow.selectedLabel}</span>
                      </button>
                    ))}
                  </div>

                  <div class="workflow-stage-panels">
                    {workflow.scenario.stages.map((stage, stageIndex) => (
                      <section
                        class="workflow-stage"
                        id={`scenario-${workflow.id}-${stage.id}`}
                        data-workflow-stage={stage.id}
                      >
                        <p class="workflow-stage__ordinal">0{stageIndex + 1} / {stage.label}</p>
                        <h4>{stage.title}</h4>
                        <p class="workflow-stage__copy">{stage.body}</p>
                        <details class="workflow-confirmation">
                          <summary>{c.workflow.confirmationSummary}</summary>
                          <p>{stage.confirmation}</p>
                        </details>
                      </section>
                    ))}
                  </div>

                  <div class="workflow-traversal" data-workflow-traversal hidden>
                    <button class="workflow-traversal__button" type="button" data-workflow-previous disabled>
                      {c.workflow.previousAction}
                    </button>
                    <p class="workflow-position" data-workflow-position aria-live="polite" aria-atomic="true"></p>
                    <button class="workflow-traversal__button" type="button" data-workflow-next>
                      {c.workflow.nextAction}
                    </button>
                  </div>
                  <a class="workflow-return" href="#scenarios" data-workflow-return hidden>{c.workflow.returnAction}</a>
                </article>
              ))}
            </div>
            <p class="visually-hidden" data-workflow-status aria-live="polite" aria-atomic="true"></p>
          </div>
        </div>
      </section>

      <section class="demo-section section-pad" id="demo" aria-labelledby="demo-title">
        <div class="wrap">
          <div class="section-heading section-heading--demo">
            <h2 id="demo-title">{c.demo.title}</h2>
            <p>{c.demo.intro}</p>
          </div>

          <div class="demo-workbench" data-chain-root>
            <aside class="demo-context" id="demo-source" aria-labelledby="demo-source-title">
              <p class="demo-context__label">{c.demo.contextLabel}</p>
              <h3 id="demo-source-title" data-chain-source-heading tabindex="-1">{c.scenarios.commerce.title}</h3>
              <blockquote>{c.scenarios.commerce.question}</blockquote>
              <p class="demo-context__copy">{c.scenarios.commerce.description}</p>
              <span class="demo-status">{c.demo.illustrativeLabel}</span>
            </aside>

            <div class="demo-timeline">
              <h3 class="demo-timeline__heading">{c.demo.timelineHeading}</h3>
              <div class="demo-mode-toggle" role="group" aria-label={c.demo.viewModeLabel} data-chain-view-toggle hidden>
                <button type="button" data-chain-view-option="linear" aria-pressed="true">{c.demo.linearView}</button>
                <button type="button" data-chain-view-option="orbit" aria-pressed="false">{c.demo.orbitView}</button>
              </div>
              <div class="demo-map" data-chain-map>
                <nav aria-label={c.demo.timelineLabel}>
                  <ol class="chain-track">
                    {c.demo.steps.map((step, index) => (
                      <li>
                        <a
                          class="chain-step"
                          href={`#demo-step-${step.id}`}
                          data-chain-step
                          data-index={index}
                          data-label={step.label}
                          data-summary={step.title}
                          aria-label={step.label}
                          aria-current={index === 0 ? "step" : undefined}
                        >
                          <span class="chain-step__index" aria-hidden="true">0{index + 1}</span>
                          <span class="chain-step__label">{step.label}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </nav>
                <div class="demo-map__hub" aria-hidden="true">
                  <span>{c.demo.focusLabel}</span>
                  <strong data-chain-center>{c.demo.steps[0].label}</strong>
                </div>
              </div>
              <div class="demo-scrubber" data-chain-controls hidden>
                <div class="demo-scrubber__labels">
                  <label for="trace-range">{c.demo.scrubberLabel}</label>
                  <output for="trace-range" data-chain-output>{c.demo.steps[0].label}</output>
                </div>
                <input
                  id="trace-range"
                  type="range"
                  min="0"
                  max={c.demo.steps.length - 1}
                  step="1"
                  value="0"
                  aria-valuetext={c.demo.steps[0].label}
                  aria-describedby="trace-range-help"
                  data-chain-range
                />
                <p id="trace-range-help">{c.demo.scrubberHelp}</p>
              </div>
            </div>

            <aside class="demo-inspector" aria-label={c.demo.focusLabel}>
              <p class="demo-inspector__label">{c.demo.focusLabel}</p>
              {c.demo.steps.map((step, index) => (
                <article class="demo-detail" id={`demo-step-${step.id}`} data-chain-panel data-index={index}>
                  <p class="demo-detail__type">{step.label}</p>
                  <h3 data-chain-heading tabindex="-1">{step.title}</h3>
                  <p>{step.body}</p>
                  <a class="return-link" href="#demo-source" data-chain-return>
                    <span class="return-link__icon" aria-hidden="true"></span>{c.demo.returnAction}
                  </a>
                </article>
              ))}
              <p class="visually-hidden" data-chain-status aria-live="polite" aria-atomic="true"></p>
            </aside>
          </div>
          <p class="demo-return-note">{c.demo.returnNote}</p>
        </div>
      </section>

      <section class="surfaces-section section-pad" aria-labelledby="surfaces-title">
        <div class="wrap">
          <div class="section-heading">
            <h2 id="surfaces-title">{c.surfaces.title}</h2>
            <p>{c.surfaces.intro}</p>
          </div>
          <dl class="surface-ledger">
            {[c.surfaces.public, c.surfaces.web, c.surfaces.desktop, c.surfaces.mobile].map((surface, index) => (
              <div class="surface-row">
                <dt>
                  <span aria-hidden="true">0{index + 1}</span>
                  <strong>{surface.title}</strong>
                  <small>{surface.label}</small>
                </dt>
                <dd>{surface.description}</dd>
              </div>
            ))}
          </dl>
          <p class="surface-note">{c.surfaces.note}</p>
        </div>
      </section>

      <section class="access-section section-pad" id="access" aria-labelledby="access-title">
        <div class="wrap">
          <div class="section-heading">
            <h2 id="access-title">{c.access.title}</h2>
            <p>{c.access.intro}</p>
          </div>
          <ul class="access-list">
            {accessItems.map((item) => (
              <li class="access-item" id={item.statusId}>
                <h3>{item.title}</h3>
                <p class="access-item__state">
                  <span class:list={["status-dot", { "status-dot--configured": Boolean(item.href) }]} aria-hidden="true"></span>
                  {item.href ? c.access.configured : c.access.unconfigured}
                </p>
                {item.href ? (
                  <a class="action-link action-link--access" data-magnetic href={item.href} aria-describedby={`${item.statusId}-description`}>
                    {item.action}<span class="action-link__icon" aria-hidden="true"></span>
                  </a>
                ) : (
                  <span class="action-link action-link--disabled" aria-describedby={`${item.statusId}-description`} aria-disabled="true">
                    {item.action}<span class="action-link__icon action-link__icon--unavailable" aria-hidden="true"></span>
                  </span>
                )}
                <span id={`${item.statusId}-description`} class="visually-hidden">
                  {item.href ? c.access.configured : c.access.unconfigured}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div>
          <a class="wordmark wordmark--footer" href={localePath[locale]}>
            <svg class="wordmark__mark" viewBox="0 0 30 30" aria-hidden="true" focusable="false">
              <g stroke-width="1.35">
                <path d="M24.3777697427 20.7495595182 A11 11 0 1 1 24.1818406332 8.9424590314" />
                <path d="M19.0717816262 20.6939085335 A7 7 0 1 1 21.3534329537 12.0616518751" />
              </g>
              <circle cx="15" cy="15" r="1.5" />
            </svg>
            <span>{c.footer.product}</span>
          </a>
          <p>{c.footer.note}</p>
        </div>
        <nav class="footer-nav" aria-label={c.footer.navigationLabel}>
          {c.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="#access">{c.access.workspace.title}</a>
        </nav>
      </div>
    </footer>
    <script src="../scripts/site-motion.js"></script>
  </body>
</html>
