{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"zbc://podcast/domain/v1",
  "title":"ZBC Podcast Domain Graph v1",
  "type":"object",
  "required":["entity_type","entity_id","created_at","evidence_status"],
  "properties":{
    "entity_type":{"type":"string","enum":["show","episode","person","topic","question","transcript","segment","story_node","content_asset","platform_observation","audience_signal","learning_case"]},
    "entity_id":{"type":"string","minLength":1},
    "parent_id":{"type":["string","null"]},
    "title":{"type":["string","null"]},
    "start_ms":{"type":["integer","null"],"minimum":0},
    "end_ms":{"type":["integer","null"],"minimum":0},
    "speaker_id":{"type":["string","null"]},
    "attributes":{"type":"object","additionalProperties":true},
    "relations":{"type":"array","items":{"type":"object","required":["relation","target_id"],"properties":{"relation":{"type":"string","minLength":1},"target_id":{"type":"string","minLength":1}},"additionalProperties":false}},
    "evidence_ids":{"type":"array","items":{"type":"string"}},
    "evidence_status":{"type":"string","enum":["observed","derived","ai_suggested","human_verified","unverified"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"}
  },
  "additionalProperties":false,
  "allOf":[{"if":{"properties":{"entity_type":{"const":"segment"}}},"then":{"required":["start_ms","end_ms"]}}]
}