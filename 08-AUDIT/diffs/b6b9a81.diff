+# =========================================================
+# SAFE REPAIR
+# =========================================================
+
+def safe_repairs(files):
+
+    """
+    只执行明确、安全的修复。
+    不自动改业务 API、不自动改数据库、不自动删除 CSS。
+    """
+
+    repairs = []
+
+    # --------------------------------------------
+    # 1. 删除明显的 Python 调试断点
+    # --------------------------------------------
+
+    for p in files:
+
+        if p.suffix != ".py":
+            continue
+
+        text = read_text(p)
+
+        if "breakpoint()" in text:
+
+            new = re.sub(
+                r"^[ \t]*breakpoint\(\)[ \t]*\r?\n",
+                "",
+                text,
+                flags=re.M,
+            )
+
+            if new != text:
+
+                safe_write(
+                    p,
+                    new,
+                )
+
+                repairs.append({
+                    "file": str(p.relative_to(ROOT)),
+                    "type": "REMOVE_DEBUG_BREAKPOINT",
+                })
+
+    # --------------------------------------------
+    # 2. 删除明显 console.debug
+    # --------------------------------------------
+
+    for p in files:
+
+        if p.suffix.lower() not in {
+            ".js",
+            ".jsx",
+            ".ts",
+            ".tsx",
+        }:
+            continue
+
+        text = read_text(p)
+
+        new = re.sub(
+            r"^[ \t]*console\.debug\s*\([^;]*\);?[ \t]*\r?\n",
+            "",
+            text,
+            flags=re.M,
+        )
+
+        if new != text:
+
+            safe_write(
+                p,
+                new,
+            )
+
+            repairs.append({
+                "file": str(p.relative_to(ROOT)),
+                "type": "REMOVE_DEBUG_LOG",
+            })
+
+    results["repairs"] = repairs
+
