+# ── 8. 与 ToolDefinition 兼容 ───────────────────────────────────
+
+class TestToolDefinitionCompatibility:
+    """from_tool_definition 应能从 ToolDefinition 兼容结构构建 SmartTool。"""
+
+    def test_from_dict_definition(self):
