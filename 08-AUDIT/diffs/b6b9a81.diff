+# =========================================================
+# SERVER
+# =========================================================
+
+def port_from_url():
+
+    m = re.search(
+        r":(\d+)",
+        BASE_URL,
+    )
+
+    return int(m.group(1)) if m else 5000
+
+
+def port_open():
+
+    port = port_from_url()
+
+    s = socket.socket()
+
+    try:
+
+        s.settimeout(0.5)
+
+        return (
+            s.connect_ex(
+                ("127.0.0.1", port)
+            )
+            == 0
+        )
+
+    finally:
+
+        s.close()
+
+
+def start_server():
+
+    if port_open():
+
+        log(
+            f"[SERVER] 已发现运行中的系统 {BASE_URL}"
+        )
+
+        return None
+
+    app = ROOT / "app.py"
+
+    if not app.exists():
+
+        log(
+            "[SERVER] 未找到 app.py，无法自动启动 Flask"
+        )
+
+        return None
+
+    log("[SERVER] 启动应用...")
+
+    proc = subprocess.Popen(
+        [sys.executable, "app.py"],
+        cwd=ROOT,
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+    )
+
+    for _ in range(20):
+
+        if port_open():
+            break
+
+        time.sleep(1)
+
+    return proc
+
