{
  "version": "2026.08.27",
  "description": "系统函数映射表，用于开发者工具和AI调用",
  "functions": {
    "collect": {
      "name": "采集数据",
      "description": "触发小红书数据采集",
      "endpoint": "/api/collect/trigger",
      "method": "POST",
      "params": {"keyword": "搜索关键词", "max_scroll": "滚动次数", "max_details": "详情数量"}
    },
    "collect_status": {
      "name": "采集状态",
      "description": "获取当前采集状态和今日计数",
      "endpoint": "/api/collect/status",
      "method": "GET",
      "params": {}
    },
    "notes_list": {
      "name": "笔记列表",
      "description": "获取笔记列表，支持分页和筛选",
      "endpoint": "/api/notes",
      "method": "GET",
      "params": {"page": "页码", "per_page": "每页数量", "sentiment": "情绪筛选", "industry": "业态筛选"}
    },
    "note_detail": {
      "name": "笔记详情",
      "description": "获取单条笔记详情",
      "endpoint": "/api/notes/<note_id>",
      "method": "GET",
      "params": {"note_id": "笔记ID"}
    },
    "negative_pending": {
      "name": "待确认负面",
      "description": "获取待确认的负面笔记列表",
      "endpoint": "/api/negative/pending",
      "method": "GET",
      "params": {"page": "页码", "per_page": "每页数量"}
    },
    "negative_confirm": {
      "name": "确认负面",
      "description": "确认负面笔记",
      "endpoint": "/api/negative/confirm",
      "method": "POST",
      "params": {"note_id": "笔记ID", "reason": "确认原因"}
    },
    "negative_reject": {
      "name": "驳回负面",
      "description": "驳回负面笔记",
      "endpoint": "/api/negative/reject",
      "method": "POST",
      "params": {"note_id": "笔记ID", "reason": "驳回原因"}
    },
    "negative_stats": {
      "name": "负面统计",
      "description": "获取负面舆情统计",
      "endpoint": "/api/negative/stats",
      "method": "GET",
      "params": {}
    },
    "events_list": {
      "name": "事件列表",
      "description": "获取舆情事件列表",
      "endpoint": "/api/events",
      "method": "GET",
      "params": {"page": "页码", "per_page": "每页数量", "level": "事件等级"}
    },
    "event_detail": {
      "name": "事件详情",
      "description": "获取单个舆情事件详情",
      "endpoint": "/api/events/<event_id>",
      "method": "GET",
      "params": {"event_id": "事件ID"}
    },
    "report_export": {
      "name": "导出报告",
      "description": "导出日报/周报/月报/年报",
      "endpoint": "/api/report/export",
      "method": "GET",
      "params": {"type": "报告类型(daily/weekly/monthly/yearly)", "date": "日期", "format": "格式(word/excel)"}
    },
    "ai_analyze": {
      "name": "AI分析",
      "description": "使用AI分析舆情数据",
      "endpoint": "/api/ai/analyze",
      "method": "POST",
      "params": {"note_id": "笔记ID", "prompt": "分析提示词", "provider": "AI提供商"}
    },
    "ai_providers": {
      "name": "AI提供商列表",
      "description": "获取可用的AI提供商列表",
      "endpoint": "/api/ai/providers",
      "method": "GET",
      "params": {}
    },
    "trends_global": {
      "name": "全局趋势",
      "description": "获取全局舆情趋势数据",
      "endpoint": "/api/trends/global",
      "method": "GET",
      "params": {"days": "天数"}
    },
    "publish_buckets": {
      "name": "发布时间分桶",
      "description": "按发布时间区分当日发布和历史采集",
      "endpoint": "/api/notes/publish-buckets",
      "method": "GET",
      "params": {"date": "日期"}
    },
    "dashboard_changes": {
      "name": "仪表盘变更",
      "description": "获取仪表盘数据变更，用于实时刷新",
      "endpoint": "/api/dashboard/changes",
      "method": "GET",
      "params": {"last_check": "上次检查时间"}
    },
    "weekly_events": {
      "name": "周报事件",
      "description": "获取本周舆情事件列表",
      "endpoint": "/api/weekly/events",
      "method": "GET",
      "params": {"week_start": "周开始日期"}
    },
    "web_browser_discovery": {
      "name": "全网浏览器发现",
      "description": "通过普通浏览器搜索发现舆情话题，不占用小红书检索次数",
      "endpoint": "/api/web/browser-discovery",
      "method": "GET",
      "params": {"keyword": "搜索关键词"}
    },
    "brand_industry": {
      "name": "品牌业态监测",
      "description": "获取品牌业态全网监测数据",
      "endpoint": "/api/web/brand-industry/<brand>",
      "method": "GET",
      "params": {"brand": "品牌名称"}
    },
    "web_topics": {
      "name": "全网话题",
      "description": "获取全网热门话题事件",
      "endpoint": "/api/web-topics",
      "method": "GET",
      "params": {}
    },
    "web_topics_refresh": {
      "name": "刷新全网话题",
      "description": "手动刷新全网话题缓存",
      "endpoint": "/api/web-topics/refresh",
      "method": "POST",
      "params": {}
    },
    "overview": {
      "name": "总览数据",
      "description": "获取系统总览数据",
      "endpoint": "/api/overview",
      "method": "GET",
      "params": {}
    },
    "alerts": {
      "name": "告警列表",
      "description": "获取系统告警列表",
      "endpoint": "/api/alerts",
      "method": "GET",
      "params": {"unread": "是否只显示未读"}
    },
    "alert_read": {
      "name": "标记告警已读",
      "description": "标记告警为已读，消除红点",
      "endpoint": "/api/alerts/<alert_id>/read",
      "method": "POST",
      "params": {"alert_id": "告警ID"}
    },
    "settings_get": {
      "name": "获取设置",
      "description": "获取系统设置",
      "endpoint": "/api/settings",
      "method": "GET",
      "params": {}
    },
    "settings_update": {
      "name": "更新设置",
      "description": "更新系统设置",
      "endpoint": "/api/settings",
      "method": "POST",
      "params": {"settings": "设置项"}
    },
    "developer_run": {
      "name": "运行代码",
      "description": "开发者工具：运行升级代码并部署",
      "endpoint": "/api/developer/run",
      "method": "POST",
      "params": {"code": "要运行的代码"}
    },
    "email_test": {
      "name": "测试邮件",
      "description": "测试邮件发送配置",
      "endpoint": "/api/email/test",
      "method": "POST",
      "params": {"to": "收件邮箱"}
    },
    "domain_add": {
      "name": "添加公司域名",
      "description": "添加公司域名接入配置",
      "endpoint": "/api/domain/add",
      "method": "POST",
      "params": {"domain": "域名", "config": "配置"}
    },
    "domain_delete": {
      "name": "删除公司域名",
      "description": "删除公司域名接入配置",
      "endpoint": "/api/domain/delete",
      "method": "POST",
      "params": {"domain": "域名"}
    }
  },
  "last_updated": "2026-08-27"
}