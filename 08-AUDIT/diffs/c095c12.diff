+  const cols = new Set();
+  list.slice(0, 20).forEach(item => {
+    if (item && typeof item === 'object') Object.keys(item).forEach(k => cols.add(k));
+  });
+  // 优先级排序
+  const priority = ['title','name','nickname','author','content','summary','text','description','topic','brand','subject','sentiment','emotion','risk_level','status','likes','comments','collects','shares','views','platform','source','publish_datetime','created_at','date','captured_at','id','note_id','event_id'];
+  return priority.filter(p => cols.has(p)).concat([...cols].filter(c => !priority.includes(c))).slice(0, 12);
+}
+
+function renderTable(list, cols) {
+  const thead = document.getElementById('table-head');
+  const tbody = document.getElementById('table-body');
+  thead.innerHTML = '<tr>' + cols.map(c => '<th>' + c + '</th>').join('') + '</tr>';
+  tbody.innerHTML = list.slice(0, 100).map(item => {
+    return '<tr>' + cols.map(c => {
+      let val = item ? item[c] : '';
+      if (val === null || val === undefined) val = '';
+      if (typeof val === 'object') val = JSON.stringify(val);
+      val = String(val).slice(0, 200);
+      return '<td>' + escapeHtml(val) + '</td>';
+    }).join('') + '</tr>';
+  }).join('');
+  if (list.length > 100) {
+    tbody.innerHTML += '<tr><td colspan="' + cols.length + '" style="text-align:center;color:var(--lm-color-text-secondary);font-size:12px;">仅显示前 100 条，共 ' + list.length + ' 条</td></tr>';
+  }
+}
+
+function escapeHtml(s) {
+  const div = document.createElement('div');
+  div.textContent = s;
+  return div.innerHTML;
+}
+
+// 时间范围切换
+document.querySelectorAll('.lm-time-pill').forEach(btn => {
+  btn.addEventListener('click', function() {
+    document.querySelectorAll('.lm-time-pill').forEach(b => b.classList.remove('is-active'));
+    this.classList.add('is-active');
+    loadPanelData();
+  });
+});
+
+// 等待 LUMENIS 初始化后再加载数据
+function _waitForLUMENIS(cb) {
+  if (window.LUMENIS && window.LUMENIS.fetch) { cb(); }
+  else { setTimeout(() => _waitForLUMENIS(cb), 50); }
+}
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', () => _waitForLUMENIS(loadPanelData));
+} else {
+  _waitForLUMENIS(loadPanelData);
+}
+</script>
+{% endblock %}
diff --git a/templates/cth/qa.html b/templates/cth/qa.html
new file mode 100644
index 0000000..bec34e1
--- /dev/null
+++ b/templates/cth/qa.html
@@ -0,0 +1,199 @@
+{% extends "base.html" %}
+{% block title %}智能问答 · 序境 LUMENIS{% endblock %}
+{% block page_title %}智能问答{% endblock %}
+
+{% block content %}
+<div class="lm-viewport" data-domain="cth">
+  <div class="lm-viewport__context">
+    <div class="lm-section-header" style="margin:0;">
+      <div class="lm-section-header__title">序境 · 智能问答</div>
+    </div>
+    <p class="lm-section-header__desc" style="color:var(--lm-color-text-secondary);margin:4px 0 0;">AI 智能问答 · 舆情/品牌/风险一站式咨询（CTH保护域）</p>
+  </div>
+
+  <!-- 快捷问题按钮 -->
+  <div style="display:flex;gap:8px;flex-wrap:wrap;margin:16px 0;">
+    <button class="lm-btn lm-btn--ghost" onclick="askQuick('今日舆情概览')">📊 今日舆情概览</button>
+    <button class="lm-btn lm-btn--ghost" onclick="askQuick('当前风险预警')">⚠️ 当前风险预警</button>
+    <button class="lm-btn lm-btn--ghost" onclick="askQuick('品牌表现分析')">🏷️ 品牌表现分析</button>
+    <button class="lm-btn lm-btn--ghost" onclick="askQuick('热点话题趋势')">🔥 热点话题趋势</button>
+  </div>
+
+  <!-- 聊天区域 -->
+  <div class="lm-panel" style="margin-bottom:16px;">
+    <div class="lm-panel__header">
+      <span class="lm-panel__title">对话</span>
+      <button class="lm-btn lm-btn--ghost" style="margin-left:auto;font-size:12px;" onclick="clearChat()">清空对话</button>
+    </div>
+    <div class="lm-panel__body">
+      <div id="chat-messages" style="min-height:300px;max-height:500px;overflow-y:auto;padding:8px 0;">
+        <div style="text-align:center;color:var(--lm-color-text-secondary);font-size:13px;padding:40px 0;">
+          <div style="font-size:32px;margin-bottom:12px;">💬</div>
+          <div>你想了解什么？输入问题开始对话</div>
+          <div style="font-size:11px;margin-top:8px;opacity:0.7;">AI 输出仅供参考，核心数据以系统规则为准</div>
+        </div>
+      </div>
+    </div>
+  </div>
+
+  <!-- 输入区域 -->
+  <div style="display:flex;gap:8px;align-items:flex-end;">
+    <textarea id="chat-input" rows="2" placeholder="输入你的问题…（Ctrl+Enter 发送）"
+      style="flex:1;padding:10px 14px;border:1px solid var(--lm-color-border);border-radius:8px;
+             background:var(--lm-color-bg);color:var(--lm-color-text);font-size:14px;resize:vertical;
+             font-family:inherit;outline:none;"
+      onkeydown="if(event.key==='Enter'&&event.ctrlKey){sendMessage();}"></textarea>
+    <button class="lm-btn lm-btn--primary" id="send-btn" onclick="sendMessage()" style="height:42px;padding:0 24px;">
+      发送
+    </button>
+  </div>
+</div>
+
+<script>
+let chatHistory = [];
+
+function askQuick(q) {
+  document.getElementById('chat-input').value = q;
+  sendMessage();
+}
+
+function clearChat() {
+  chatHistory = [];
+  document.getElementById('chat-messages').innerHTML =
+    '<div style="text-align:center;color:var(--lm-color-text-secondary);font-size:13px;padding:40px 0;">' +
+    '<div style="font-size:32px;margin-bottom:12px;">💬</div>' +
+    '<div>你想了解什么？输入问题开始对话</div></div>';
+}
+
+function addMessage(role, content) {
+  const container = document.getElementById('chat-messages');
+  // 移除空状态
+  const empty = container.querySelector('div[style*="text-align:center"]');
+  if (empty && empty.textContent.includes('你想了解什么')) empty.remove();
+
+  const msg = document.createElement('div');
+  msg.style.marginBottom = '16px';
+  msg.style.display = 'flex';
+  msg.style.flexDirection = role === 'user' ? 'row-reverse' : 'row';
+  msg.style.gap = '8px';
+
+  const avatar = document.createElement('div');
+  avatar.style.width = '32px';
+  avatar.style.height = '32px';
+  avatar.style.borderRadius = '50%';
+  avatar.style.background = role === 'user' ? 'var(--lm-color-primary, #333)' : 'var(--lm-color-bg-secondary, #f5f5f5)';
+  avatar.style.color = role === 'user' ? '#fff' : 'var(--lm-color-text)';
+  avatar.style.display = 'flex';
+  avatar.style.alignItems = 'center';
+  avatar.style.justifyContent = 'center';
+  avatar.style.fontSize = '14px';
+  avatar.style.flexShrink = '0';
+  avatar.textContent = role === 'user' ? '我' : 'AI';
+
+  const bubble = document.createElement('div');
+  bubble.style.maxWidth = '75%';
+  bubble.style.padding = '10px 14px';
+  bubble.style.borderRadius = '12px';
+  bubble.style.background = role === 'user' ? 'var(--lm-color-primary, #333)' : 'var(--lm-color-bg-secondary, #f5f5f5)';
+  bubble.style.color = role === 'user' ? '#fff' : 'var(--lm-color-text)';
+  bubble.style.fontSize = '13px';
+  bubble.style.lineHeight = '1.6';
+  bubble.style.whiteSpace = 'pre-wrap';
+  bubble.style.wordBreak = 'break-word';
+  bubble.textContent = content;
+
+  msg.appendChild(avatar);
+  msg.appendChild(bubble);
+  container.appendChild(msg);
+  container.scrollTop = container.scrollHeight;
+}
+
+function addTyping() {
+  const container = document.getElementById('chat-messages');
+  const typing = document.createElement('div');
+  typing.id = 'typing-indicator';
+  typing.style.display = 'flex';
+  typing.style.gap = '8px';
+  typing.style.marginBottom = '16px';
+  typing.innerHTML = '<div style="width:32px;height:32px;border-radius:50%;background:var(--lm-color-bg-secondary);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;">AI</div>' +
+    '<div style="padding:10px 14px;border-radius:12px;background:var(--lm-color-bg-secondary);font-size:13px;">' +
+    '<span style="display:inline-block;animation:lm-blink 1s infinite;">●</span> ' +
+    '<span style="display:inline-block;animation:lm-blink 1s 0.2s infinite;">●</span> ' +
+    '<span style="display:inline-block;animation:lm-blink 1s 0.4s infinite;">●</span></div>';
+  container.appendChild(typing);
+  container.scrollTop = container.scrollHeight;
+}
+
+function removeTyping() {
+  const t = document.getElementById('typing-indicator');
+  if (t) t.remove();
+}
+
+async function sendMessage() {
+  const input = document.getElementById('chat-input');
+  const btn = document.getElementById('send-btn');
+  const q = input.value.trim();
+  if (!q) return;
+
+  input.value = '';
+  btn.disabled = true;
+  btn.textContent = '发送中…';
+  addMessage('user', q);
+  addTyping();
+
+  try {
+    // 等待 LUMENIS 初始化
+    await new Promise((resolve) => {
+      if (window.LUMENIS && window.LUMENIS.fetch) resolve();
+      else { const t = setInterval(() => { if (window.LUMENIS && window.LUMENIS.fetch) { clearInterval(t); resolve(); } }, 50); }
+    });
+
+    const res = await LUMENIS.fetch('/api/ai/chat', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        message: q,
+        domain: 'cth',
+        history: chatHistory.slice(-6)
+      })
+    });
+
+    removeTyping();
+
+    if (!res.ok) {
+      // 尝试其他 AI 接口
+      const res2 = await LUMENIS.fetch('/api/ai/analyze', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ query: q, domain: 'cth' })
+      });
+      if (res2.ok) {
+        const data2 = await res2.json();
+        const answer = data2.answer || data2.result || data2.summary || JSON.stringify(data2, null, 2).slice(0, 2000);
+        addMessage('ai', answer);
+        chatHistory.push({ role: 'user', content: q });
+        chatHistory.push({ role: 'assistant', content: answer });
+      } else {
+        addMessage('ai', `AI 接口暂不可用（HTTP ${res.status}/${res2.status}）。请稍后重试，或检查 AI 服务配置。`);
+      }
+    } else {
+      const data = await res.json();
+      const answer = data.reply || data.answer || data.response || data.result || data.message || data.content || JSON.stringify(data, null, 2).slice(0, 2000);
+      addMessage('ai', answer);
+      chatHistory.push({ role: 'user', content: q });
+      chatHistory.push({ role: 'assistant', content: answer });
+    }
+  } catch (e) {
+    removeTyping();
+    addMessage('ai', `请求失败：${e.message}。请检查网络连接或 AI 服务状态。`);
+  } finally {
+    btn.disabled = false;
+    btn.textContent = '发送';
+    input.focus();
+  }
+}
+
+// 聚焦输入框
+setTimeout(() => { document.getElementById('chat-input')?.focus(); }, 500);
+</script>
+{% endblock %}
