{
  "version": "P1-H-20260903",
  "dimensions": ["data_protection", "personal_info", "ai", "web_scraping",
                 "cross_border", "data_minimization", "copyright"],
  "jurisdictions": ["CN", "HK", "EU", "UK", "US"],
  "principles": [
    "合法使用法律允许的例外、豁免、授权、最小化、去标识化、地域适配和架构隔离。",
    "禁止绕过访问控制/验证码/平台安全机制、伪造授权、规避付费权限、爬取受限制数据。",
    "不确定时 BLOCK / HUMAN REVIEW。"
  ],
  "rules": [
    {"id": "DP-01", "jurisdiction": "*", "dimension": "data_protection", "action": "store_secret", "verdict": "BLOCK", "reason": "Cookie/Token/密钥绝不入库（ZBC AGENTS 红线）", "ref": "AGENTS.md"},
    {"id": "DP-02", "jurisdiction": "*", "dimension": "data_protection", "action": "export_credentials", "verdict": "BLOCK", "reason": "凭证不外发"},
    {"id": "SC-01", "jurisdiction": "*", "dimension": "web_scraping", "action": "bypass_auth", "verdict": "BLOCK", "reason": "禁止绕过访问控制"},
    {"id": "SC-02", "jurisdiction": "*", "dimension": "web_scraping", "action": "bypass_captcha", "verdict": "BLOCK", "reason": "禁止绕过验证码"},
    {"id": "SC-03", "jurisdiction": "*", "dimension": "web_scraping", "action": "scrape_public_notes", "verdict": "REVIEW", "reason": "公开笔记采集需遵循平台规则/Robots/最小化，限频限并发", "ref": "P1-A 采集稳定性"},
    {"id": "SC-04", "jurisdiction": "EU", "dimension": "web_scraping", "action": "scrape_public_notes", "verdict": "REVIEW", "reason": "GDPR 语境下公开数据再处理仍需合法基础与目的限制", "ref": "GDPR Art.5/6"},
    {"id": "SC-05", "jurisdiction": "*", "dimension": "web_scraping", "action": "scrape_profile", "verdict": "REVIEW", "reason": "个人信息类字段需最小化+合法性基础"},
    {"id": "PI-01", "jurisdiction": "*", "dimension": "personal_info", "action": "collect_pii", "verdict": "REVIEW", "reason": "需明确合法性基础+目的限制+数据最小化"},
    {"id": "PI-02", "jurisdiction": "EU", "dimension": "personal_info", "action": "collect_pii", "verdict": "REVIEW", "reason": "GDPR Art.5(1)(c) 数据最小化；6(1) 合法基础", "ref": "GDPR"},
    {"id": "PI-03", "jurisdiction": "CN", "dimension": "personal_info", "action": "collect_pii", "verdict": "REVIEW", "reason": "《个人信息保护法》告知同意/最小必要", "ref": "PIPL"},
    {"id": "AI-01", "jurisdiction": "*", "dimension": "ai", "action": "send_cloud_ai", "verdict": "REVIEW", "reason": "云端AI发送前必须脱敏，敏感信息不出内网", "ref": "intelligence.redact_for_cloud"},
    {"id": "CB-01", "jurisdiction": "*", "dimension": "cross_border", "action": "export_personal_data", "verdict": "REVIEW", "reason": "跨境传输需评估合法性/安全评估/标准合同"},
    {"id": "DM-01", "jurisdiction": "*", "dimension": "data_minimization", "action": "collect_excessive", "verdict": "REVIEW", "reason": "仅采集完成业务所需最小字段"},
    {"id": "DM-02", "jurisdiction": "*", "dimension": "data_minimization", "action": "retain_forever", "verdict": "REVIEW", "reason": "数据保留期限需定义并遵循法域要求"},
    {"id": "CP-01", "jurisdiction": "*", "dimension": "copyright", "action": "reproduce_copyrighted", "verdict": "REVIEW", "reason": "商业使用需版权/授权核验；避免大段复现原创内容"},
    {"id": "CP-02", "jurisdiction": "*", "dimension": "copyright", "action": "repost_user_content", "verdict": "REVIEW", "reason": "用户内容再发布需授权/去标识化评估"}
  ]
}
