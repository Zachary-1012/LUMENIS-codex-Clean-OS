---
interface Props { kind?: 'gypsophila' | 'orchid' | 'lily' | 'palm' | 'grape' | 'jasmine'; class?: string }
const { kind = 'gypsophila', class: className } = Astro.props;
type Pixel = { x: number; y: number; width: number; color: string };
const marks: ({ type: 'pixel' } & Pixel | { type: 'leaf'; points: string; color: string })[] = [];
const stem = 'var(--stem, #355e3b)';
const petal = 'var(--petal, #e2e7d9)';
const pollen = 'var(--pollen, #8f601c)';
function leaf(points: number[][], color: string) {
  marks.push({ type: 'leaf', points: points.map(point => point.join(',')).join(' '), color });
}
function pixel(x: number, y: number, color: string, width = 1) {
  marks.push({ type: 'pixel', x, y, width, color });
}
function line(x0: number, y0: number, x1: number, y1: number, color: string) {
  const dx = Math.abs(x1-x0), dy = -Math.abs(y1-y0);
  const sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1;
  let error = dx + dy;
  for (;;) {
    pixel(x0, y0, color);
    if (x0 === x1 && y0 === y1) break;
    const twice = error * 2;
    if (twice >= dy) { error += dy; x0 += sx; }
    if (twice <= dx) { error += dx; y0 += sy; }
  }
}
function flower(x: number, y: number, color: string, r = 1) {
  pixel(x-r, y-1, stem, r+1); pixel(x, y-r, stem, r+1);
  pixel(x-r, y, color, r); pixel(x+1, y, color, r);
  pixel(x, y-r, color, r); pixel(x, y+1, color, r);
  pixel(x, y, pollen);
}
switch (kind) {
  case 'gypsophila':
    for (const [x,y,ax,ay] of [[5,10,12,20],[8,5,12,14],[14,4,16,17],[22,6,18,20],[27,12,22,20],[6,19,13,23],[24,21,19,25],[18,10,16,17],[12,13,15,21]]) {
      line(16,29,ax,ay,stem); line(ax,ay,x,y,stem); flower(x,y,petal);
    }
    break;
  case 'orchid':
    line(15,29,17,10,stem);
    leaf([[15,29],[5,20],[9,21],[15,26]],stem);
    leaf([[15,29],[26,20],[24,25],[18,29]],stem);
    for (const points of [
      [[15,14],[9,5],[5,6],[6,11],[12,15]],
      [[17,14],[22,4],[26,6],[25,11],[19,16]],
      [[14,17],[12,21],[16,24],[20,21],[18,17]],
    ]) leaf(points,'var(--orchid, #876e9c)');
    for (const points of [
      [[14,14],[5,12],[2,16],[7,19],[14,17]],
      [[18,14],[27,12],[30,16],[25,19],[18,17]],
      [[15,13],[13,5],[16,2],[19,5],[17,13]],
    ]) leaf(points,'var(--orchid-light, #c3b5d0)');
    flower(16,17,petal);
    break;
  case 'lily':
    line(16,29,16,14,stem);
    for (const [x,y] of [[5,8],[10,4],[17,3],[24,6],[28,12],[5,17],[26,20]]) {
      line(16,15,x,y,petal); line(x,y,x+(x<16?2:-2),y-2,petal); pixel(x,y,pollen);
    }
    flower(16,13,petal,2);
    break;
  case 'palm':
    leaf([[18,30],[21,30],[18,20],[16,12],[14,12],[16,22]],pollen);
    for (const [x,y] of [[3,9],[4,16],[10,3],[20,4],[28,10],[26,18]]) {
      leaf([[15,11],[x,y],[x,y+3],[(x+15)/2,(y+14)/2]],'var(--leaf, #4a8764)');
      line(15,11,x,y,stem);
    }
    pixel(14,13,pollen,3); pixel(18,12,pollen,3);
    break;
  case 'grape':
    line(16,3,16,11,stem); line(16,5,25,4,stem);
    line(16,6,9,3,stem); line(9,3,5,7,stem); line(5,7,12,9,stem); line(12,9,16,6,stem);
    for (const [x,y] of [[10,11],[17,11],[7,16],[14,16],[21,16],[11,21],[18,21],[15,26]]) {
      const grape = 'var(--grape, #876e9c)';
      pixel(x,y+1,grape,4); pixel(x+1,y,grape,2); pixel(x+1,y+4,grape,2);
      pixel(x+1,y+1,'var(--grape-light, #c3b5d0)',2);
    }
    break;
  case 'jasmine':
    line(16,29,16,14,stem);
    leaf([[16,27],[5,18],[6,24],[12,28]],stem);
    leaf([[16,24],[27,16],[26,22],[20,26]],stem);
    for (const [x,y] of [[16,5],[8,10],[23,10],[11,18],[21,18]]) {
      leaf([[16,12],[x-2,y-1],[x,y-3],[x+3,y],[x+1,y+3]],stem);
      leaf([[16,12],[x-1,y],[x,y-2],[x+2,y],[x,y+2]],petal);
    }
    pixel(15,11,pollen,3);
}
---
<svg class:list={['pixel-plant', `pixel-plant--${kind}`, className]} viewBox="0 0 32 32" fill="none" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {marks.map(mark => mark.type === 'leaf'
    ? <polygon points={mark.points} fill={mark.color} />
    : <rect x={mark.x} y={mark.y} width={mark.width} height={mark.width} fill={mark.color} />)}
</svg>
