{
  "schema_version": "1.0",
  "purpose": "Evidence-bearing contract for Zachary internal maturation",
  "experience": {
    "required": ["experience_id", "product_id", "domain_id", "task_id", "observed_at", "source_type", "source_ref", "user_intent", "action_taken", "outcome", "provenance", "privacy_scope", "promotion_status"],
    "optional": ["session_id", "input_context", "constraints", "reasoning_summary", "outcome_metrics", "feedback", "candidate_pattern", "counter_pattern", "confidence", "valid_from", "valid_until", "capability_class"]
  },
  "memory_classes": ["GLOBAL_CORE", "DOMAIN", "SESSION", "EVIDENCE", "QUARANTINE"],
  "capability_classes": ["CORE-GENERAL", "DOMAIN-BOUND", "ADAPTER"],
  "promotion_statuses": ["OBSERVED", "CANDIDATE", "DOMAIN-VERIFIED", "TRANSFER-CANDIDATE", "CORE-VERIFIED", "REJECTED", "REPAIRED", "RETIRED"],
  "write_gate": ["provenance", "scope", "authorization", "temporal_validity", "conflict_check", "evidence_quality"],
  "retrieval_gate": ["domain_match", "task_relevance", "temporal_validity", "evidence_level", "conflict_check", "authorization"],
  "promotion_gate": ["baseline", "measurable_outcome", "reproducibility", "counterexample_analysis", "failure_analysis", "isolation_check", "regression_check", "provenance"],
  "core_promotion_requires": ["origin_domain_evidence", "independent_domain_evidence", "abstract_pattern", "negative_transfer_check", "no_domain_implementation_leakage"],
  "invariants": ["domain_memory_never_implicitly_becomes_global", "product_architecture_never_becomes_core_capability", "unauthorized_cross_domain_access_is_denied", "synthetic_examples_are_not_real_world_evidence", "promoted_capabilities_are_versioned_and_reversible"]
}
