---
import type { Locale } from "../i18n";

const { locale } = Astro.props as { locale: Locale };

const copy = {
  "zh-CN": {
    eyebrow: "真实操作",
    title: "把草稿留下，接着写",
    description: "展开草稿，补充想法。保存到本地，再从上次写到的地方继续。",
    videoLabel: "草稿编辑、保存和重新打开的真实录屏",
    fallback: "当前浏览器不支持内嵌视频。",
    download: "下载原视频",
    caption: "无声录屏。可打开字幕，或展开文字说明。",
    stepsLabel: "操作步骤",
    steps: [
      "展开草稿，补充想法和制作安排。",
      "把草稿保存到本地文件。",
      "清空输入框，再从同一文件重新打开。",
      "从保存的内容继续写。",
    ],
    detailsLabel: "查看完整文字说明",
    details: "录屏保留了画面中的连接失败提示。这里演示的是草稿编辑、文件保存与恢复；没有进行 AI 分析，录制时分析服务未连接，也没有生成播客成品。",
  },
  en: {
    eyebrow: "A real product operation",
    title: "Save a draft. Pick it up again.",
    description: "Expand a draft and add your ideas. Save it locally, then pick up where you left off.",
    videoLabel: "Real screen recording of editing, saving, and reopening a draft",
    fallback: "This browser does not support embedded video.",
    download: "Download the original video",
    caption: "Silent screen recording. Turn on captions or expand the written steps.",
    stepsLabel: "What happens",
    steps: [
      "Expand the draft and add ideas and production notes.",
      "Save the draft to a local file.",
      "Clear the editor, then reopen the same file.",
      "Continue from the saved content.",
    ],
    detailsLabel: "Read the full description",
    details: "The recording keeps the connection failure visible in the interface. It demonstrates draft editing, file saving, and recovery only; no AI analysis or finished podcast is shown, and the analysis service was disconnected during recording.",
  },
  ko: {
    eyebrow: "실제 제품 조작",
    title: "초안을 저장하고 이어서 쓰세요",
    description: "초안을 펼쳐 생각을 더하세요. 로컬에 저장하고 쓰던 부분부터 이어갑니다.",
    videoLabel: "초안 편집, 저장 및 다시 열기 실제 화면 녹화",
    fallback: "현재 브라우저는 동영상 삽입 재생을 지원하지 않습니다.",
    download: "원본 동영상 다운로드",
    caption: "음성이 없는 화면 녹화입니다. 자막을 켜거나 문자 안내를 펼쳐 보세요.",
    stepsLabel: "작업 순서",
    steps: [
      "초안을 펼쳐 아이디어와 제작 계획을 적습니다.",
      "초안을 로컬 파일로 저장합니다.",
      "입력창을 비우고 같은 파일을 다시 엽니다.",
      "저장한 내용에서 이어서 씁니다.",
    ],
    detailsLabel: "전체 문자 안내 보기",
    details: "화면에 나타난 연결 실패 상태를 녹화에 그대로 남겼습니다. 이 영상은 초안 편집, 파일 저장과 복구만 보여 줍니다. AI 분석은 실행하지 않았고 녹화 당시 분석 서비스가 연결되지 않았으며 팟캐스트 완성본도 생성되지 않았습니다.",
  },
} as const;

const c = copy[locale];
const videoPath = "/media/draft-editing-20261011.mp4";
const posterPath = "/media/draft-editing-20261011.jpg";
const tracks = [
  {
    src: "/media/draft-editing-20261011.zh-CN.vtt",
    lang: "zh-CN",
    label: "简体中文",
    isDefault: locale === "zh-CN",
  },
  {
    src: "/media/draft-editing-20261011.en.vtt",
    lang: "en",
    label: "English",
    isDefault: locale === "en",
  },
  {
    src: "/media/draft-editing-20261011.ko.vtt",
    lang: "ko",
    label: "한국어",
    isDefault: locale === "ko",
  },
];
---

<section class="operation-demo section-pad" id="operation-video" aria-labelledby="operation-demo-title">
  <div class="wrap">
    <header class="operation-demo__heading">
      <p class="operation-demo__eyebrow">{c.eyebrow}</p>
      <h2 id="operation-demo-title">{c.title}</h2>
      <p class="operation-demo__intro">{c.description}</p>
    </header>

    <div class="operation-demo__layout">
      <figure class="operation-demo__figure">
        <div class="operation-demo__frame">
          <video
            class="operation-demo__video"
            controls
            playsinline
            preload="metadata"
            poster={posterPath}
            aria-label={c.videoLabel}
          >
            <source src={videoPath} type="video/mp4" />
            {tracks.map((track) => (
              <track
                kind="captions"
                src={track.src}
                srclang={track.lang}
                label={track.label}
                default={track.isDefault}
              />
            ))}
            <p>{c.fallback}</p>
          </video>
        </div>
        <figcaption class="operation-demo__caption">
          <span>{c.caption}</span>
          <a href={videoPath} download>{c.download}<span aria-hidden="true"> ↗</span></a>
        </figcaption>
      </figure>

      <aside class="operation-demo__side" aria-label={c.stepsLabel}>
        <h3>{c.stepsLabel}</h3>
        <ol class="operation-demo__steps">
          {c.steps.map((step, index) => (
            <li>
              <span class="operation-demo__step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
        <details class="operation-demo__details">
          <summary>{c.detailsLabel}</summary>
          <p>{c.details}</p>
        </details>
      </aside>
    </div>
  </div>
</section>
