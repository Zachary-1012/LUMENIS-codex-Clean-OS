+# -*- coding: utf-8 -*-
+"""
+TAIKOO MONITOR
+FULL SELF AUDIT + SAFE AUTO REPAIR + BROWSER REGRESSION
+
+链路：
+SOURCE
+ -> BACKEND
+ -> DATABASE
+ -> API CONTRACT
+ -> FRONTEND
+ -> CSS/UI
+ -> PLAYWRIGHT
+ -> SECURITY
+ -> AUTO REPAIR
+ -> BUILD
+ -> REGRESSION
+ -> ROLLBACK IF FAILED
+"""
+
+import asyncio
+import json
+import os
+import re
+import shutil
+import socket
+import subprocess
+import sys
+import time
+from datetime import datetime
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent
+
+BASE_URL = os.environ.get(
+    "TAIKOO_BASE_URL",
+    "http://127.0.0.1:5000"
+)
+
+RUN_ID = datetime.now().strftime("%Y%m%d_%H%M%S")
+
+BACKUP_DIR = ROOT / ".self_repair" / RUN_ID
+REPORT = ROOT / f"SELF_REPAIR_REPORT_{RUN_ID}.json"
+
+IGNORE = {
+    ".git",
+    ".venv",
+    "venv",
+    "node_modules",
+    "__pycache__",
+    ".self_repair",
+    "dist",
+    "build",
+    ".pytest_cache",
+}
+
+TEXT_EXT = {
+    ".py",
+    ".js",
+    ".jsx",
+    ".ts",
+    ".tsx",
+    ".html",
+    ".htm",
+    ".css",
+    ".scss",
+    ".vue",
+    ".json",
+    ".sql",
+}
+
+results = {
+    "run_id": RUN_ID,
+    "root": str(ROOT),
+    "base_url": BASE_URL,
+    "started_at": datetime.now().isoformat(),
+    "source": {},
+    "backend": {},
+    "database": {},
+    "api_contract": {},
+    "frontend": {},
+    "ui": {},
+    "ux": {},
+    "security": {},
+    "browser": {},
+    "repairs": [],
+    "regression": {},
+    "final_status": "NOT VERIFIED",
+}
+
+
+# =========================================================
+# 基础
+# =========================================================
+
+def log(msg):
+    print(msg, flush=True)
+
+
+def run_cmd(cmd, timeout=300):
+    try:
+        p = subprocess.run(
+            cmd,
+            cwd=ROOT,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            shell=isinstance(cmd, str),
+        )
+
+        return {
+            "returncode": p.returncode,
+            "stdout": p.stdout[-12000:],
+            "stderr": p.stderr[-12000:],
+        }
+
+    except Exception as e:
+        return {
+            "returncode": -1,
+            "stdout": "",
+            "stderr": str(e),
+        }
+
+
+def save_report():
+    REPORT.write_text(
+        json.dumps(
+            results,
+            ensure_ascii=False,
+            indent=2,
+        ),
+        encoding="utf-8",
+    )
+
+
+def project_files():
+    out = []
+
+    for p in ROOT.rglob("*"):
+
+        if not p.is_file():
+            continue
+
+        if any(part in IGNORE for part in p.parts):
+            continue
+
+        if p.suffix.lower() in TEXT_EXT:
+            out.append(p)
+
+    return out
+
+
+def read_text(p):
+    try:
+        return p.read_text(encoding="utf-8")
+    except Exception:
+        try:
+            return p.read_text(encoding="utf-8-sig")
+        except Exception:
+            return ""
+
+
+def backup_file(p):
+    rel = p.relative_to(ROOT)
+    target = BACKUP_DIR / rel
+
+    target.parent.mkdir(
+        parents=True,
+        exist_ok=True,
+    )
+
+    if not target.exists():
+        shutil.copy2(p, target)
+
+
+def safe_write(p, text):
+    backup_file(p)
+    p.write_text(
+        text,
+        encoding="utf-8",
+    )
+
+
+# =========================================================
+# SOURCE AUDIT
+# =========================================================
+
+def source_audit():
+
+    fs = project_files()
+
+    counts = {}
+
+    for p in fs:
+        ext = p.suffix.lower()
+        counts[ext] = counts.get(ext, 0) + 1
+
+    results["source"] = {
+        "files": len(fs),
+        "extensions": counts,
+    }
+
+    return fs
+
+
+# =========================================================
+# BACKEND ROUTES
+# =========================================================
+
+def find_backend_routes(files):
+
+    routes = []
+
+    patterns = [
+        r'@\w+\.route\s*\(\s*[\'"]([^\'"]+)',
+        r'@app\.route\s*\(\s*[\'"]([^\'"]+)',
+        r'@(?:\w+\.)?(?:get|post|put|delete|patch)\s*\(\s*[\'"]([^\'"]+)',
+    ]
+
+    for p in files:
+
+        if p.suffix != ".py":
+            continue
+
+        text = read_text(p)
+
+        for pattern in patterns:
+
+            for match in re.findall(pattern, text):
+
+                routes.append({
+                    "route": match.rstrip("/"),
+                    "file": str(p.relative_to(ROOT)),
+                })
+
+    return routes
+
+
+# =========================================================
+# FRONTEND API
+# =========================================================
+
+def find_frontend_api_calls(files):
+
+    calls = []
+
+    patterns = [
+        r'fetch\s*\(\s*[`\'"]([^`\'"]+)',
+        r'axios\.(?:get|post|put|delete|patch)\s*\(\s*[`\'"]([^`\'"]+)',
+        r'url\s*:\s*[`\'"]([^`\'"]+)',
+    ]
+
+    for p in files:
+
+        if p.suffix.lower() not in {
+            ".js",
+            ".jsx",
+            ".ts",
+            ".tsx",
+            ".html",
+            ".vue",
+        }:
+            continue
+
+        text = read_text(p)
+
+        for pattern in patterns:
+
+            for match in re.findall(pattern, text):
+
+                if match.startswith("/"):
+
+                    calls.append({
+                        "api": match.split("?")[0].rstrip("/"),
+                        "file": str(p.relative_to(ROOT)),
+                    })
+
+    return calls
+
+
+def normalize_api(x):
+
+    x = x.split("?")[0]
+    x = re.sub(r"\$\{[^}]+\}", "", x)
+    x = re.sub(r"<[^>]+>", "", x)
+
+    return x.rstrip("/") or "/"
+
+
+def api_contract_audit(files):
+
+    routes = find_backend_routes(files)
+    calls = find_frontend_api_calls(files)
+
+    route_set = {
+        normalize_api(x["route"])
+        for x in routes
+    }
+
+    missing = []
+
+    for call in calls:
+
+        api = normalize_api(call["api"])
+
+        if api in route_set:
+            continue
+
+        matched = False
+
+        for route in route_set:
+
+            if api.startswith(route + "/"):
+                matched = True
+                break
+
+            if route.startswith(api + "/"):
+                matched = True
+                break
+
+        if not matched:
+            missing.append(call)
+
+    results["api_contract"] = {
+        "backend_route_count": len(routes),
+        "frontend_api_count": len(calls),
+        "unmatched_frontend_api": missing,
+    }
+
