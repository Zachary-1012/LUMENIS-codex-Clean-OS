+        def do_something(x: int = 0):
+            return x + 1
+        assert do_something.tool_id == "custom_id"
+        assert do_something.name == "自定义工具"
+        result = do_something.execute({"x": 5})
+        assert result.data == 6
+
+    def test_wrap_type_coercion(self):
