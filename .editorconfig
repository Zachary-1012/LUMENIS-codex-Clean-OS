root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.pyi]
indent_size = 4

[*.ps1]
indent_size = 4

[{*.json,*.yml,*.yaml,*.dart,*.js,*.mjs,*.ts,*.tsx,*.jsx,*.css,*.scss,*.html,*.astro}]
indent_size = 2

[{*.bat,*.cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
