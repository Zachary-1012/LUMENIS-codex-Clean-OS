{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"zai://runtime/global-evidence/v1",
  "title":"Global Runtime Evidence Contract v1",
  "type":"object",
  "required":["run_id","module","started_at","status","return_status","heartbeat","last_success_at","evidence_ids"],
  "properties":{
    "run_id":{"type":"string","minLength":1},
    "module":{"type":"string","minLength":1},
    "operation":{"type":["string","null"]},
    "started_at":{"type":"string","format":"date-time"},
    "completed_at":{"type":["string","null"],"format":"date-time"},
    "status":{"type":"string","enum":["queued","running","success","partial","failed","no_return","recovering","cancelled"]},
    "return_status":{"type":"string","enum":["pending","returned","partial","missing","acknowledged"]},
    "heartbeat":{"type":"object","required":["last_at","interval_ms"],"properties":{"last_at":{"type":"string","format":"date-time"},"interval_ms":{"type":"integer","minimum":1}},"additionalProperties":false},
    "last_success_at":{"type":["string","null"],"format":"date-time"},
    "requested":{"type":["integer","null"],"minimum":0},
    "processed":{"type":["integer","null"],"minimum":0},
    "succeeded":{"type":["integer","null"],"minimum":0},
    "failed":{"type":["integer","null"],"minimum":0},
    "error_class":{"type":["string","null"]},
    "evidence_ids":{"type":"array","items":{"type":"string"}},
    "metadata":{"type":"object","additionalProperties":true}
  },
  "additionalProperties":false
}