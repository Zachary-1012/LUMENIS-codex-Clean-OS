+def ui_static_audit(files):
+
+    findings = []
+
+    for p in files:
+
+        if p.suffix.lower() not in {
+            ".css",
+            ".scss",
+            ".js",
+            ".jsx",
+            ".ts",
+            ".tsx",
+            ".html",
+            ".vue",
+        }:
+            continue
+
+        text = read_text(p)
+
+        important = len(
+            re.findall(
+                r"!important",
+                text,
+                re.I,
+            )
+        )
+
+        inline = len(
+            re.findall(
+                r'\bstyle\s*=',
+                text,
+                re.I,
+            )
+        )
+
+        dynamic_style = len(
+            re.findall(
+                r'\.style\.[A-Za-z_-]+\s*=',
+                text,
+            )
+        )
+
+        if important:
+
+            findings.append({
+                "file": str(p.relative_to(ROOT)),
+                "type": "IMPORTANT",
+                "count": important,
+            })
+
+        if inline:
+
+            findings.append({
+                "file": str(p.relative_to(ROOT)),
+                "type": "INLINE_STYLE",
+                "count": inline,
+            })
+
+        if dynamic_style:
+
+            findings.append({
+                "file": str(p.relative_to(ROOT)),
+                "type": "DYNAMIC_STYLE",
+                "count": dynamic_style,
+            })
+
+    results["ui"]["static_override_findings"] = findings
+
