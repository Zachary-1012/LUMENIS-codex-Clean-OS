{
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.codeActionsOnSave": {},
  "editor.rename.enablePreview": true,
  "files.autoSave": "off",
  "git.autorefresh": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.exclude": [
    "**/work/**",
    "**/node_modules/**",
    "**/build/**",
    "**/.venv/**"
  ],
  "ruff.nativeServer": "on",
  "ruff.importStrategy": "useBundled",
  "dart.runPubGetOnPubspecChanges": "never",
  "dart.runPubGetOnPubspecChangesWarning": false,
  "powershell.codeFormatting.autoCorrectAliases": false,
  "typescript.suggest.autoImports": true,
  "javascript.suggest.autoImports": true,
  "task.allowAutomaticTasks": "off",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.PowerShell",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  "dart.analysisExcludedFolders": [
    "${workspaceFolder}/work",
    "${workspaceFolder}/.venv",
    "${workspaceFolder}/node_modules",
    "${workspaceFolder}/website/node_modules",
    "${workspaceFolder}/app/build",
    "${workspaceFolder}/.git",
    "${workspaceFolder}/data",
    "${workspaceFolder}/.codex",
    "${workspaceFolder}/00-GOVERNANCE",
    "${workspaceFolder}/02-ARCHITECTURE"
  ]
}
