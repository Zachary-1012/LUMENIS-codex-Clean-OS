+  transition: all var(--zbc-duration-fast) var(--zbc-ease);
+  cursor: pointer;
+  text-decoration: none;
+}
+
+.nav-item:hover,
+.sidebar a:hover,
+.menu-item:hover {
+  background: rgba(47,158,110,0.06);
+  color: var(--zbc-text-primary);
+  transform: translateX(2px);
+}
+
+.nav-item.active,
+.sidebar a.active,
+.menu-item.active {
+  background: var(--zbc-primary-gradient);
+  color: #fff;
+  box-shadow: var(--zbc-shadow-glow-green);
+}
+
+/* ========== 模态框/弹窗 ========== */
+.modal,
+.zbc-modal,
+.dialog {
+  background: var(--zbc-glass-strong);
+  backdrop-filter: var(--zbc-blur);
+  -webkit-backdrop-filter: var(--zbc-blur);
+  border: 1px solid var(--zbc-border);
+  border-radius: var(--zbc-radius-xl);
+  box-shadow: var(--zbc-shadow-xl);
+  animation: zbc-modal-in var(--zbc-duration-normal) var(--zbc-ease-spring);
+}
+
+@keyframes zbc-modal-in {
+  from { opacity: 0; transform: scale(0.94) translateY(10px); }
+  to { opacity: 1; transform: scale(1) translateY(0); }
+}
+
+.modal-overlay,
+.zbc-overlay {
+  background: rgba(15, 20, 30, 0.35);
+  backdrop-filter: blur(6px);
+  -webkit-backdrop-filter: blur(6px);
+  animation: zbc-fade-in var(--zbc-duration-fast);
+}
+
+@keyframes zbc-fade-in {
+  from { opacity: 0; }
+  to { opacity: 1; }
+}
+
+/* ========== 进度条 ========== */
+.zbc-progress,
+.progress-bar {
+  height: 6px;
+  background: rgba(0,0,0,0.06);
+  border-radius: var(--zbc-radius-pill);
+  overflow: hidden;
+}
+
+.zbc-progress-fill,
+.progress-fill {
+  height: 100%;
+  background: var(--zbc-primary-gradient);
+  border-radius: var(--zbc-radius-pill);
+  transition: width 0.8s var(--zbc-ease);
+  position: relative;
+  overflow: hidden;
+}
+
+.zbc-progress-fill::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
+  animation: zbc-shimmer 2s infinite;
+}
+
+@keyframes zbc-shimmer {
+  0% { transform: translateX(-100%); }
+  100% { transform: translateX(100%); }
+}
+
+/* ========== 骨架屏 ========== */
+.skeleton,
+.zbc-skeleton {
+  background: linear-gradient(90deg, rgba(0,0,0,0.04) 25%, rgba(0,0,0,0.08) 50%, rgba(0,0,0,0.04) 75%);
+  background-size: 200% 100%;
+  animation: zbc-skeleton 1.5s infinite;
+  border-radius: var(--zbc-radius-sm);
+}
+
+@keyframes zbc-skeleton {
+  0% { background-position: 200% 0; }
+  100% { background-position: -200% 0; }
+}
+
+/* ========== 进入动画 ========== */
+.zbc-enter {
+  animation: zbc-enter-up var(--zbc-duration-normal) var(--zbc-ease) both;
+}
+
+.zbc-enter-delay-1 { animation-delay: 0.05s; }
+.zbc-enter-delay-2 { animation-delay: 0.10s; }
+.zbc-enter-delay-3 { animation-delay: 0.15s; }
+.zbc-enter-delay-4 { animation-delay: 0.20s; }
+
+@keyframes zbc-enter-up {
+  from { opacity: 0; transform: translateY(16px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+/* ========== 数字滚动 ========== */
+.zbc-count-up {
+  font-variant-numeric: tabular-nums;
+}
+
+/* ========== 滚动条 ========== */
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-track { background: transparent; }
+::-webkit-scrollbar-thumb {
+  background: rgba(0,0,0,0.12);
+  border-radius: var(--zbc-radius-pill);
+}
+::-webkit-scrollbar-thumb:hover { background: rgba(0,0,0,0.22); }
+
+/* ========== 减少动效偏好 ========== */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+}
+
+/* ========== 响应式 ========== */
+@media (max-width: 768px) {
+  .zbc-card, .card { border-radius: var(--zbc-radius-md); }
+  .kpi-value { font-size: 22px; }
+  .modal, .zbc-modal { border-radius: var(--zbc-radius-lg); margin: 12px; }
+}
