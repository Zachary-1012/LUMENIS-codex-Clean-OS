{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"zbc://podcast/research-case/v1",
  "title":"Podcast Research Case v1",
  "type":"object",
  "required":["case_id","case_type","title","sources","evidence_status","observed_at"],
  "properties":{
    "case_id":{"type":"string"},
    "case_type":{"type":"string","enum":["show","episode","person","topic","format","hook","production","distribution","failure","breakout","platform"]},
    "title":{"type":"string"},
    "subject":{"type":["string","null"]},
    "sources":{"type":"array","items":{"type":"string"}},
    "observed_at":{"type":"string","format":"date-time"},
    "published_at":{"type":["string","null"],"format":"date-time"},
    "runtime_seconds":{"type":["number","null"],"minimum":0},
    "metrics":{"type":"object","additionalProperties":{"type":["number","string","null"]}},
    "dimensions":{"type":"object","additionalProperties":{"type":["number","string","boolean","null"]}},
    "hypotheses":{"type":"array","items":{"type":"string"}},
    "lessons":{"type":"array","items":{"type":"string"}},
    "evidence_status":{"type":"string","enum":["observed","derived","ai_suggested","human_verified","unverified"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "relations":{"type":"array","items":{"type":"object","required":["relation","target_id"],"properties":{"relation":{"type":"string"},"target_id":{"type":"string"}},"additionalProperties":false}}
  },
  "additionalProperties":true
}
