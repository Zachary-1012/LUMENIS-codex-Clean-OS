diff --git a/templates/cth/analysis.html b/templates/cth/analysis.html
new file mode 100644
index 0000000..e7736fe
--- /dev/null
+++ b/templates/cth/analysis.html
@@ -0,0 +1,194 @@
+{% extends "base.html" %}
+{% block title %}舆情分析 · 序境 LUMENIS{% endblock %}
+{% block page_title %}舆情分析{% endblock %}
+
+{% block content %}
+<div class="lm-viewport" data-domain="cth">
+  <div class="lm-viewport__context">
+    <div class="lm-section-header" style="margin:0;">
+      <div class="lm-section-header__title">舆情分析</div>
+      <div class="lm-time-dimension">
+        <button class="lm-time-pill is-active" data-range="7d">7D</button>
+        <button class="lm-time-pill" data-range="30d">30D</button>
+        <button class="lm-time-pill" data-range="90d">90D</button>
+      </div>
+    </div>
+    <p class="lm-section-header__desc" style="color:var(--lm-color-text-secondary);margin:4px 0 0;">舆情分析 · 声量/情绪/互动/趋势多维分析（CTH保护域）</p>
+  </div>
+
+  <!-- KPI 概览 -->
+  <div class="lm-kpi-row" id="kpi-row" style="display:none;margin:16px 0;gap:12px;">
+    <div class="lm-kpi-card"><div class="lm-kpi-card__value" id="kpi-total">—</div><div class="lm-kpi-card__label">总数</div></div>
+    <div class="lm-kpi-card"><div class="lm-kpi-card__value" id="kpi-today">—</div><div class="lm-kpi-card__label">今日</div></div>
+    <div class="lm-kpi-card"><div class="lm-kpi-card__value" id="kpi-positive">—</div><div class="lm-kpi-card__label">正面</div></div>
+    <div class="lm-kpi-card"><div class="lm-kpi-card__value" id="kpi-negative">—</div><div class="lm-kpi-card__label">负面</div></div>
+  </div>
+
+  <!-- 六态面板 -->
+  <section class="lm-panel" id="main-panel" data-state="loading" data-api="/api/trend/overview">
+    <div class="lm-panel__header">
+      <span class="lm-panel__title">数据列表</span>
+      <span class="lm-status-badge lm-status-badge--info">CTH</span>
+      <button class="lm-btn lm-btn--ghost" style="margin-left:auto;" onclick="loadPanelData()">刷新</button>
+    </div>
+    <div class="lm-panel__body">
+      <div class="xj-state xj-state--loading" id="state-loading">
+        <div class="xj-spinner"></div><p>加载中…</p>
+      </div>
+      <div class="xj-state xj-state--empty" id="state-empty" style="display:none;">
+        <div class="xj-empty-icon">📭</div><p>暂无数据</p>
+        <p style="font-size:12px;color:var(--lm-color-text-secondary);">API 返回空结果，可能是该域下尚无数据采集</p>
+        <button class="lm-btn lm-btn--primary" onclick="loadPanelData()">刷新</button>
+      </div>
+      <div class="xj-state xj-state--error" id="state-error" style="display:none;">
+        <div class="xj-error-icon">⚠️</div><p>加载失败</p>
+        <p id="error-msg" style="font-size:12px;color:var(--lm-color-danger);"></p>
+        <button class="lm-btn lm-btn--primary" onclick="loadPanelData()">重试</button>
+      </div>
+      <div class="xj-state xj-state--success" id="state-success" style="display:none;">
+        <div class="lm-data-table-wrap">
+          <table class="lm-data-table" id="data-table">
+            <thead id="table-head"></thead>
+            <tbody id="table-body"></tbody>
+          </table>
+        </div>
+        <div id="raw-json" style="margin-top:16px;display:none;">
+          <details><summary style="cursor:pointer;font-size:12px;color:var(--lm-color-text-secondary);">查看原始 JSON</summary>
+            <pre id="raw-json-content" style="font-size:11px;max-height:300px;overflow:auto;background:var(--lm-color-bg-secondary);padding:12px;border-radius:8px;margin-top:8px;"></pre>
+          </details>
+        </div>
+      </div>
+    </div>
+  </section>
+</div>
+
+<script>
+let currentData = null;
+
+async function loadPanelData() {
+  const api = document.getElementById('main-panel').dataset.api;
+  setState('loading');
+  try {
+    const res = await LUMENIS.fetch(api);
+    if (!res.ok) throw new Error('HTTP ' + res.status);
+    const data = await res.json();
+    currentData = data;
+    renderData(data);
+    setState('success');
+  } catch(e) {
+    console.error('Load failed:', e);
+    document.getElementById('error-msg').textContent = e.message;
+    setState('error');
+  }
+}
+
+function setState(state) {
+  const panel = document.getElementById('main-panel');
+  panel.dataset.state = state;
+  ['loading','empty','error','success'].forEach(s => {
+    const el = document.getElementById('state-' + s);
+    if (el) el.style.display = (s === state) ? '' : 'none';
+  });
+}
+
+function extractList(data) {
+  // 从各种 API 返回结构中提取列表
+  if (Array.isArray(data)) return data;
+  if (data && typeof data === 'object') {
+    for (const key of ['data','items','list','results','records','notes','cases','events','rows']) {
+      if (Array.isArray(data[key])) return data[key];
+    }
+    // 如果没有列表字段，把对象本身转为单元素数组
+    return [data];
+  }
+  return [];
+}
+
+function renderData(data) {
+  const list = extractList(data);
+  if (!list || list.length === 0) {
+    setState('empty');
+    return;
+  }
+  // KPI
+  document.getElementById('kpi-row').style.display = 'flex';
+  document.getElementById('kpi-total').textContent = list.length;
+  const todayCount = list.filter(item => {
+    const d = item.publish_datetime || item.created_at || item.date || item.captured_at || '';
+    return String(d).startsWith('2026-09-07') || String(d).includes('09-07');
+  }).length;
+  document.getElementById('kpi-today').textContent = todayCount;
+  const posCount = list.filter(item => {
+    const s = (item.sentiment || item.emotion || item.polarity || '').toString().toLowerCase();
+    return s.includes('pos') || s.includes('正面') || s === '1';
+  }).length;
+  const negCount = list.filter(item => {
+    const s = (item.sentiment || item.emotion || item.polarity || item.risk_level || '').toString().toLowerCase();
+    return s.includes('neg') || s.includes('负面') || s.includes('高') || s.includes('紧急') || s === '-1';
+  }).length;
+  document.getElementById('kpi-positive').textContent = posCount || '—';
+  document.getElementById('kpi-negative').textContent = negCount || '—';
+
+  // 表格
+  const cols = inferColumns(list);
+  renderTable(list, cols);
+  // 原始 JSON
+  document.getElementById('raw-json').style.display = '';
+  document.getElementById('raw-json-content').textContent = JSON.stringify(data, null, 2).slice(0, 20000);
+}
+
+function inferColumns(list) {
+  const cols = new Set();
+  list.slice(0, 20).forEach(item => {
+    if (item && typeof item === 'object') Object.keys(item).forEach(k => cols.add(k));
+  });
+  // 优先级排序
+  const priority = ['title','name','nickname','author','content','summary','text','description','topic','brand','subject','sentiment','emotion','risk_level','status','likes','comments','collects','shares','views','platform','source','publish_datetime','created_at','date','captured_at','id','note_id','event_id'];
+  return priority.filter(p => cols.has(p)).concat([...cols].filter(c => !priority.includes(c))).slice(0, 12);
+}
+
+function renderTable(list, cols) {
+  const thead = document.getElementById('table-head');
+  const tbody = document.getElementById('table-body');
+  thead.innerHTML = '<tr>' + cols.map(c => '<th>' + c + '</th>').join('') + '</tr>';
+  tbody.innerHTML = list.slice(0, 100).map(item => {
+    return '<tr>' + cols.map(c => {
+      let val = item ? item[c] : '';
+      if (val === null || val === undefined) val = '';
+      if (typeof val === 'object') val = JSON.stringify(val);
+      val = String(val).slice(0, 200);
+      return '<td>' + escapeHtml(val) + '</td>';
+    }).join('') + '</tr>';
+  }).join('');
+  if (list.length > 100) {
+    tbody.innerHTML += '<tr><td colspan="' + cols.length + '" style="text-align:center;color:var(--lm-color-text-secondary);font-size:12px;">仅显示前 100 条，共 ' + list.length + ' 条</td></tr>';
+  }
+}
+
+function escapeHtml(s) {
+  const div = document.createElement('div');
+  div.textContent = s;
+  return div.innerHTML;
+}
+
+// 时间范围切换
+document.querySelectorAll('.lm-time-pill').forEach(btn => {
+  btn.addEventListener('click', function() {
+    document.querySelectorAll('.lm-time-pill').forEach(b => b.classList.remove('is-active'));
+    this.classList.add('is-active');
+    loadPanelData();
+  });
+});
+
+// 等待 LUMENIS 初始化后再加载数据
+function _waitForLUMENIS(cb) {
+  if (window.LUMENIS && window.LUMENIS.fetch) { cb(); }
+  else { setTimeout(() => _waitForLUMENIS(cb), 50); }
+}
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', () => _waitForLUMENIS(loadPanelData));
+} else {
+  _waitForLUMENIS(loadPanelData);
+}
+</script>
+{% endblock %}
