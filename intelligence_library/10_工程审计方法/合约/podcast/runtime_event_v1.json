{
  "contract": "podcast-runtime-event",
  "version": "1.0.0",
  "required": ["runtime_id", "module", "operation", "status", "started_at", "heartbeat_at", "evidence_ids"],
  "statuses": ["queued", "running", "success", "partial", "failed", "no_return", "recovering"],
  "rules": {
    "runtime_id_is_stable_for_one_execution": true,
    "heartbeat_required_while_running": true,
    "no_return_is_not_success": true,
    "evidence_ids_may_be_empty_only_for_queued": true,
    "cross_repo_consumers_must_not_infer_missing_results": true
  }
}
